def restart_firefox() -> None:
    if ASSUME_YES:
        # an unattended run (ubuntu-tweak init) neither closes the user's browser nor opens one over ssh:
        # the policy is in place, so the extension is installed at Firefox's next start (also in --dry-run)
        say("  Firefox is not restarted by --yes: the extension is installed by policy at its next start")
        return
    if firefox_running():
        say("  closing Firefox (session restore brings your tabs back)")
        run(["pkill", "-TERM", "-x", "firefox"], check=False)
        if DRY_RUN:  # nothing was closed: do not wait for it, show the launch and stop
            run([FIREFOX_BIN])
            return
        for _ in range(40):
            if not firefox_running():
                break
            time.sleep(1)
        else:
            raise StepError("Firefox did not close within 40 s: close it manually and re-run.")
    fflog = STATE_DIR / "firefox.log"
    say(f"  starting Firefox (its output goes to {fflog})")
    if DRY_RUN:
        run([FIREFOX_BIN])
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(fflog, "a") as handle:
        subprocess.Popen([FIREFOX_BIN], start_new_session=True, stdout=handle, stderr=handle,
                         stdin=subprocess.DEVNULL)
    for _ in range(60):
        time.sleep(2)
        if extension_ready():
            return
    # the row is context only: run_actions prints a note if the extension is not active yet


