class StepError(Exception):
    pass


class NeedsYou(Exception):
    """An unattended (--yes) run cannot go on with this step without a person (a Home Assistant token,
    Firefox closed). The rest of the step is skipped, the other steps still run, and `install` ends
    with exit code 3 and the list of what is waiting for you."""


NOTES: list[str] = []  # what is waiting for a person, printed at the end of `install`


def blocked(message: str) -> NoReturn:
    """Stop this step: an unattended (--yes) run waits for a person (exit 3), an interactive one fails."""
    if ASSUME_YES:
        raise NeedsYou(message)
    raise StepError(message)


# --------------------------------------------------------------------------- helpers
STATE_DIR = Path(os.environ.get("PASSKEY_QR_STATE", HOME / ".local/state/passkey-qr"))
LOG_FILE = None  # opened by init_log()


def init_log(command: str) -> Path | None:
    """Mirror everything shown on screen (and all command output) into a log file."""
    global LOG_FILE
    path = STATE_DIR / f"{time.strftime('%Y%m%d-%H%M%S')}-{command}-{os.getpid()}.log"
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LOG_FILE = open(path, "a", buffering=1)
        if command == "install":  # latest.log always points to the last install run
            latest = STATE_DIR / "latest.log"
            latest.unlink(missing_ok=True)
            try:
                latest.symlink_to(path.name)
            except FileExistsError:  # another install started at the same moment: its link wins
                pass
    except OSError as err:
        print(f"warning: no log file ({err}); continuing without one", file=sys.stderr)
        LOG_FILE = None
        return None
    log(f"passkey-qr {command} started {time.strftime('%Y-%m-%d %H:%M:%S')} dry_run={DRY_RUN} user={getpass.getuser()}")
    return path


def log(text: str) -> None:
    if LOG_FILE:
        LOG_FILE.write(text if text.endswith("\n") else text + "\n")


def say(msg: str = "") -> None:
    print(msg, flush=True)
    log(msg)


def ask(prompt: str) -> str:
    log(f"{prompt}<waiting for input>")
    answer = input(prompt)
    log(f"  -> {answer!r}")
    return answer


def confirm(question: str, *, destructive: bool = False) -> bool:
    """Ask before a step. ``--yes`` answers for you and never prompts; a ``destructive`` step
    (removing the Firefox snap) additionally needs ``--remove-snap`` and is declined without it."""
    if destructive and ASSUME_YES and not REMOVE_SNAP:
        say(f"? {question} [no: --yes does not remove the snap without --remove-snap]")
        return False
    if ASSUME_YES:
        say(f"? {question} [yes: --yes]")
        return True
    if DRY_RUN:
        say(f"? {question} [auto-yes in dry-run]")
        return True
    while True:
        answer = ask(f"? {question} [y/N] ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("", "n", "no"):
            return False


def _argv(cmd: list[str] | str, sudo: bool) -> list[str]:
    argv = shlex.split(cmd) if isinstance(cmd, str) else [str(a) for a in cmd]
    if sudo and os.geteuid() != 0:
        argv = ["sudo", *argv]
    return argv


def run_stream(cmd: list[str] | str, *, cwd: Path | None = None, sudo: bool = False) -> tuple[int, str]:
    """Run a command, echo its output live (screen and log) and also return it."""
    argv = _argv(cmd, sudo)
    say("  $ " + " ".join(shlex.quote(a) for a in argv))
    if DRY_RUN:
        return 0, ""
    started = time.time()
    try:
        proc = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                errors="replace")
    except OSError as err:  # a missing binary is a failed step with a log, not a traceback
        raise StepError(f"cannot run {argv[0]}: {err.strerror or err}") from err
    lines: list[str] = []
    assert proc.stdout
    for line in proc.stdout:
        sys.stdout.write(line)
        log(line)
        lines.append(line)
    rc = proc.wait()
    log(f"  [exit {rc} after {time.time() - started:.1f}s]")
    return rc, "".join(lines)


def run(cmd: list[str] | str, *, sudo: bool = False, cwd: Path | None = None,
        check: bool = True) -> subprocess.CompletedProcess:
    """Run a command, echo its output live and into the log (so the child sees a pipe, not a terminal:
    apt/meson progress bars are plain text; sudo still asks for its password on /dev/tty)."""
    argv = _argv(cmd, sudo)
    rc, text = run_stream(cmd, cwd=cwd, sudo=sudo)
    if check and rc != 0:
        raise subprocess.CalledProcessError(rc, argv, output=text)
    return subprocess.CompletedProcess(argv, rc, text, "")


def out(cmd: list[str], timeout: float = 20) -> str:
    try:
        return subprocess.run([str(c) for c in cmd], capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def write_file(path: Path, content: str, mode: int = 0o644) -> None:
    say(f"  write {path} (mode {mode:o})")
    if DRY_RUN:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)


def sudo_write(path: Path, content: str) -> None:
    tmp = CACHE_DIR / "tmp" / path.name
    if not DRY_RUN:
        tmp.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text(content)
    run(["install", "-D", "-m0644", str(tmp), str(path)], sudo=True)


def read_text(path: Path) -> str | None:
    try:
        return path.read_text()
    except OSError:
        return None


def http(url: str, timeout: float = 3.0) -> int:
    try:
        with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as resp:
            return resp.status
    except urllib.error.HTTPError as err:
        return err.code
    except (urllib.error.URLError, OSError):
        return 0


@dataclass
class Action:
    name: str
    check: Callable[[], bool]
    apply: Callable[[], None]
    optional: bool = False  # confirmed separately; skipping it is not a failure
    destructive: bool = False  # with --yes it additionally needs --remove-snap
    required: bool = True   # False: context only; `check` ignores it and a failed re-check is not an error
    needs_relogin: bool = False  # under --yes a failed re-check waits for a new login (exit 3), not exit 1
    hint: str | Callable[[], str] = ""  # shown if the check still fails after apply (lazy when a callable)


def show_actions(actions: list[Action]) -> list[Action]:
    pending = []
    for action in actions:
        ok = action.check()
        say(f"  [{'x' if ok else ' '}] {action.name}")
        if not ok:
            pending.append(action)
    return pending


def run_actions(title: str, actions: list[Action], intro: str = "") -> bool:
    say(f"\n== {title} ==")
    if intro:
        say(intro)
    pending = show_actions(actions)
    if not pending:
        say("  nothing to do")
        return True
    if not confirm(f"Apply the {len(pending)} unchecked action(s) above?"):
        say("  skipped")
        return False
    for action in pending:
        if action.check():  # an earlier action may already have fixed it
            continue
        if action.optional and not confirm(f"Optional: {action.name}?", destructive=action.destructive):
            say(f"  skipped: {action.name}")
            continue
        say(f"-> {action.name}")
        try:
            action.apply()
        except NeedsYou as note:
            NOTES.append(f"{title}: {note}")
            say(f"  needs you: {note}")
            return False  # the later actions of this step depend on this one; other steps still run
        if not DRY_RUN and not action.check():
            hint = (action.hint() if callable(action.hint) else action.hint) or action.name
            if not action.required:
                say(f"  note: {action.name}: {hint}")
                continue
            if ASSUME_YES and action.needs_relogin:
                NOTES.append(f"{title}: {hint}")
                say(f"  needs you: {hint}")
                return False
            raise StepError(f"'{action.name}' was applied but the check still fails. {hint}".strip())
    return True


# --------------------------------------------------------------------------- packages
def installed_apt() -> set[str]:
    status = out(["dpkg-query", "-W", "-f=${Package} ${db:Status-Abbrev}\n"], timeout=60)
    return {line.split()[0] for line in status.splitlines() if line.endswith("ii ")}


def missing_apt() -> list[str]:
    have = installed_apt()
    return [p for p in APT_PACKAGES if p not in have]


APT_QUIET = ["env", "DEBIAN_FRONTEND=noninteractive"]  # sudo drops the caller's environment: set it after sudo
APT_CONF = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]


def apt_install(pkgs: list[str], extra: list[str] | None = None) -> None:
    """apt output goes through a pipe (see `run`), so a dpkg/debconf question without a newline would be
    invisible and look like a hang: answer them with the defaults instead."""
    run([*APT_QUIET, "apt-get", "install", "-y", *APT_CONF, *(extra or []), *pkgs], sudo=True)


# ----------------------------------------------------- automatic build-dependency fixing
DEP_PATTERNS: list[tuple[re.Pattern, str]] = [
    (re.compile(r'ERROR: Dependency "([^"]+)" not found'), "pc"),
    (re.compile(r"Package '?([\w.+-]+)'? was not found in the pkg-config search path"), "pc"),
    (re.compile(r"The system library `([\w.+-]+)` required by crate"), "pc"),
    (re.compile(r"Program ([\w.+-]+) found: NO found [\d.]+ but need"), "tool"),
    (re.compile(r"ERROR: Program '([^']+)' not found"), "bin"),
    (re.compile(r"fatal error: ([\w./+-]+\.h): No such file or directory"), "hdr"),
    (re.compile(r"fatal error: '([\w./+-]+\.h)' file not found"), "hdr"),
    (re.compile(r"\b([\w.+-]+) is not in PATH"), "bin"),
]


def find_missing(text: str) -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    for pattern, kind in DEP_PATTERNS:
        for name in pattern.findall(text):
            if (kind, name) not in found:
                found.append((kind, name))
    return found


def apt_file_search(regex: str) -> list[str]:
    if not shutil.which("apt-file"):
        say("  apt-file is needed to find which package provides a missing file")
        apt_install(["apt-file"])
    if not any(Path("/var/cache/apt/apt-file").glob("*")):
        run(["apt-file", "update"], sudo=True)
    lines = out(["apt-file", "search", "--regexp", regex], timeout=120).splitlines()
    pkgs = [line.split(":")[0] for line in lines if ":" in line]
    pkgs = [p for p in pkgs if not p.endswith(("-dbgsym", "-doc"))]
    return sorted(pkgs, key=lambda p: (not p.endswith("-dev"), len(p)))[:1]


def resolve_packages(missing: list[tuple[str, str]]) -> list[str]:
    pkgs: list[str] = []
    for kind, name in missing:
        if name in ("cargo", "rustc") and kind in ("bin", "tool"):
            say(f"  '{name}' comes from rustup (the credentialsd step), not from apt")
            continue
        if name in PKG_OVERRIDES:
            found = [PKG_OVERRIDES[name]]
        elif kind == "pc":
            found = apt_file_search(rf"/pkgconfig/{re.escape(name)}\.pc$")
        elif kind == "bin":
            found = [name] if name in ("zip", "cargo", "rustc", "meson", "ninja") else \
                apt_file_search(rf"^/(usr/)?s?bin/{re.escape(name)}$")
        else:
            found = apt_file_search(rf"/usr/include/(.*/)?{re.escape(name)}$")
        say(f"  missing {kind} '{name}' -> {', '.join(found) or 'no package found'}")
        pkgs += [p for p in found if p not in pkgs]
    return pkgs


def version_of(tool: str) -> tuple[int, ...]:
    match = re.search(r"(\d+(?:\.\d+)+)", out([tool, "--version"]))
    return tuple(int(part) for part in match.group(1).split(".")) if match else ()


def ensure_local_bin_on_path() -> None:
    """~/.cargo/bin (rustup's cargo) and ~/.local/bin (blueprint-compiler) first, once, in that order."""
    wanted = [str(CARGO_BIN), str(LOCAL_BIN)]
    rest = [p for p in os.environ.get("PATH", "").split(":") if p and p not in wanted]
    os.environ["PATH"] = ":".join(wanted + rest)


def blueprint_ok() -> bool:
    ensure_local_bin_on_path()
    return version_of("blueprint-compiler") >= BLUEPRINT_MIN


def build_blueprint() -> None:
    """Ubuntu's blueprint-compiler is too old for credentialsd-ui: build the pinned release into ~/.local."""
    src = SRC_DIR / "blueprint-compiler"
    if (src / ".git").exists():
        run(["git", "-C", str(src), "fetch", "--tags", "origin"])
    else:
        if not DRY_RUN:
            src.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", BLUEPRINT_REPO, str(src)])
    run(["git", "-C", str(src), "checkout", BLUEPRINT_TAG])
    run_resolving(["meson", "setup", "_build", "--prefix", str(HOME / ".local"), "--reconfigure"], src)
    run_resolving(["meson", "compile", "-C", "_build"], src)
    run(["meson", "install", "-C", "_build"], cwd=src)  # user prefix: no sudo
    ensure_local_bin_on_path()


SOURCE_BUILDERS: dict[str, Callable[[], None]] = {"blueprint-compiler": build_blueprint}


def run_resolving(cmd: list[str], cwd: Path, rounds: int = 30) -> None:
    """Run a build command; when it fails on a missing dependency, install it and retry."""
    tried: set[str] = set()
    for _ in range(rounds):
        rc, text = run_stream(cmd, cwd=cwd)
        if rc == 0:
            return
        missing = find_missing(text)
        wanted = [name for _, name in missing if name in SOURCE_BUILDERS and name not in tried]
        if wanted:  # tools Ubuntu ships too old: build the pinned release instead of apt
            if not confirm(f"{', '.join(wanted)} must be built from source into ~/.local (Ubuntu's is too old). Do it?"):
                raise StepError("source-built tool declined")
            for name in wanted:
                SOURCE_BUILDERS[name]()
                tried.add(name)
            continue
        have = installed_apt()
        pkgs = [p for p in resolve_packages([m for m in missing if m[1] not in SOURCE_BUILDERS]) if p not in have]
        if not pkgs or set(pkgs) <= tried:
            lines = text.splitlines()
            errs = [line for line in lines if ERROR_LINE.search(line)][:25]
            tail = "\n".join(errs + ["...", *lines[-8:]])
            raise StepError(f"`{' '.join(cmd)}` failed and no installable dependency could be identified:\n{tail}")
        if not confirm(f"Install the missing build dependencies ({' '.join(pkgs)}) with apt?"):
            raise StepError("build dependencies not installed")
        apt_install(pkgs)
        tried |= set(pkgs)
    raise StepError(f"`{' '.join(cmd)}` still failing after {rounds} rounds of installing dependencies")


# --------------------------------------------------------------------------- bluetooth state
def bt_adapters() -> list[str]:
    return sorted(p.name for p in BLUETOOTH_DIR.glob("hci*")) if BLUETOOTH_DIR.exists() else []


def is_virtual(adapter: str) -> bool:
    return "/virtual/" in str((BLUETOOTH_DIR / adapter).resolve())


def virtual_adapter() -> str | None:
    return next((a for a in bt_adapters() if is_virtual(a)), None)


def real_adapters() -> list[str]:
    return [a for a in bt_adapters() if not is_virtual(a)]


def service_active(unit: str, user: bool = False) -> bool:
    return out(["systemctl", *(["--user"] if user else []), "is-active", unit]) == "active"


def ha_url_configured() -> str | None:
    text = read_text(BRIDGE_CFG / "env") or ""
    match = re.search(r"^HA_URL=(\S+)", text, re.M)
    return match.group(1) if match else None


def ha_candidates() -> list[str]:
    if os.environ.get("HA_URL"):
        return [os.environ["HA_URL"].rstrip("/")]
    hosts = ["homeassistant.local"]
    ts = out(["tailscale", "status", "--json"])
    if ts:
        try:
            for peer in (json.loads(ts).get("Peer") or {}).values():
                if peer.get("Online") and peer.get("TailscaleIPs"):
                    hosts.append(peer["TailscaleIPs"][0])
        except json.JSONDecodeError:
            pass
    found = []
    for host in hosts:
        try:
            with socket.create_connection((host, 8123), timeout=1.5):
                if http(f"http://{host}:8123/api/") in (200, 401):
                    found.append(f"http://{host}:8123")
        except OSError:
            continue
    return found


BRIDGE_BIN = BRIDGE_DIR / "venv/bin/ha-ble-vhci"


def version_tuple(version: str) -> tuple[tuple[int, ...], int]:
    """Orderable form of a PEP 440 release: '0.1.10' -> ((0, 1, 10), 1). Trailing zeros do not count ('0.2' equals
    '0.2.0'); a pre-/dev-release sorts before its release ('0.1.6rc1' < '0.1.6') and a post-release after it
    ('0.1.6.post1' > '0.1.6'); a '+local' part is ignored."""
    numbers: list[int] = []
    rank = 1  # 0: pre/dev release, 1: the release, 2: post release
    for piece in version.split("+")[0].split("."):
        match = re.fullmatch(r"(\d+)(.*)", piece)
        if match:
            numbers.append(int(match.group(1)))
            suffix = match.group(2)
        else:
            suffix = piece
        if suffix:
            rank = 2 if suffix.startswith("post") else 0
            break
    while numbers and numbers[-1] == 0:
        numbers.pop()
    return tuple(numbers), rank


def bridge_current() -> bool:
    pip = BRIDGE_DIR / "venv/bin/pip"
    if not (pip.exists() and BRIDGE_BIN.exists()):
        return False
    match = re.search(r"^Version: (\S+)", out([str(pip), "show", "ha-ble-vhci"]), re.M)
    return bool(match) and version_tuple(match.group(1)) >= version_tuple(BRIDGE_VERSION)  # newer is fine: never downgrade


def ha_valid() -> bool:
    url = ha_url_configured()
    token = BRIDGE_CFG / "token"
    if not (BRIDGE_BIN.exists() and url and token.exists()):
        return False
    try:
        return subprocess.run([str(BRIDGE_BIN), "--check", "--url", url, "--token-file", str(token)],
                              capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def scanners_result() -> subprocess.CompletedProcess | None:
    """The bridge's ``--scanners`` answer; None when it cannot be asked (not set up) or timed out."""
    url = ha_url_configured()
    token = BRIDGE_CFG / "token"
    if not (BRIDGE_BIN.exists() and url and token.exists()):
        return None
    try:
        return subprocess.run([str(BRIDGE_BIN), "--scanners", "--url", url, "--token-file", str(token)],
                              capture_output=True, text=True, timeout=15)  # the bridge itself waits <= ~12 s
    except (OSError, subprocess.TimeoutExpired):
        return None


def bridge_proxies() -> list[str] | None:
    """Names of the Bluetooth proxies online in Home Assistant right now (live, via the bridge's
    ``--scanners``); ``[]`` when none, ``None`` when it cannot be asked (not set up / unreachable)."""
    result = scanners_result()
    if result is None:
        return None
    if result.returncode == 4:
        return []
    if result.returncode != 0:
        return None
    return [line.split("  source=")[0] for line in result.stdout.splitlines() if line.strip()]


PROXY_HINT = ("power on / reconnect the ESP32 Bluetooth proxy; the QR dialog hangs silently without one "
              "(see journalctl --user -u ha-ble-vhci)")


def show_proxy_status() -> None:
    """Live, informational line: an offline proxy is transient, so it is never drift for ``check``/installer."""
    proxies = bridge_proxies()
    if proxies is None:
        return
    if proxies:
        say(f"  [x] a Bluetooth proxy is online in Home Assistant ({', '.join(proxies)})")
    else:
        say("  [ ] a Bluetooth proxy is online in Home Assistant\n      -> " + PROXY_HINT)


def bridge_unit_text() -> str:
    return (
        "[Unit]\nDescription=Home Assistant Bluetooth proxies as a local scan-only hciN\n"
        "After=network-online.target\nWants=network-online.target\n\n"
        f"[Service]\nEnvironmentFile=-{BRIDGE_CFG}/env\nExecStart={BRIDGE_BIN}\n"
        "Restart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=default.target\n"
    )


def install_bridge() -> None:
    venv = BRIDGE_DIR / "venv"
    run([sys.executable, "-m", "venv", "--without-pip", str(venv)])
    if not DRY_RUN and not (venv / "bin/pip").exists():
        getpip = CACHE_DIR / "get-pip.py"
        getpip.parent.mkdir(parents=True, exist_ok=True)
        run(["curl", "-fsSL", "https://bootstrap.pypa.io/get-pip.py", "-o", str(getpip)])
        run([str(venv / "bin/python"), str(getpip), "-q"])
    run([str(venv / "bin/pip"), "install", "-q", "--upgrade", f"git+{BRIDGE_REPO}"])
    if service_active("ha-ble-vhci", user=True):
        run(["systemctl", "--user", "restart", "ha-ble-vhci"])  # pick up the new version


def ha_token() -> str | None:
    """A token that needs no question: ``$HA_TOKEN``, else an existing token file."""
    return os.environ.get("HA_TOKEN", "").strip() or (read_text(BRIDGE_CFG / "token") or "").strip() or None


def _hidden(prompt: str) -> str:
    log(f"{prompt}<hidden input, not logged>")
    return getpass.getpass(prompt).strip()


def configure_ha() -> None:
    url = ha_url_configured()
    stored = (read_text(BRIDGE_CFG / "token") or "").strip()
    if not url:
        say("  Looking for Home Assistant (ESPHome Bluetooth proxy) on LAN / Tailscale ...")
        found = ha_candidates()
        if found:
            say("  found: " + ", ".join(found))
        if found and confirm(f"Use Home Assistant at {found[0]}?"):
            url = found[0]
        elif not DRY_RUN and not ASSUME_YES:
            url = ask("  Home Assistant URL (e.g. http://100.x.y.z:8123), Enter to abort: ").strip().rstrip("/")
        if not url:
            blocked("No Bluetooth adapter and no Home Assistant found: plug in a USB Bluetooth (BLE) dongle, "
                    "or set HA_URL and HA_TOKEN and re-run")
        rejected = False
    else:
        rejected = bool(stored)
    if ASSUME_YES and DRY_RUN:
        token = "dry-run-token"  # the listing never asks for or prints a token
    elif ASSUME_YES:
        token = ha_token()
        if rejected and token == stored:
            token = None  # the stored token was just rejected; only a fresh $HA_TOKEN can fix it
        if not token:
            raise NeedsYou(f"Home Assistant at {url} needs a long-lived admin token: put it in $HA_TOKEN "
                           f"(or {BRIDGE_CFG / 'token'}) and re-run")
        say("  using the token from $HA_TOKEN or the token file; it is never printed")
    else:
        if rejected:
            say(f"  the stored token for {url} was rejected; enter a new one")
        say(f"  Create a long-lived token of an admin user: {url}/profile/security -> Long-lived access tokens")
        token = "dry-run-token" if DRY_RUN else _hidden("  Paste the token (hidden, Enter to abort): ")
    if not token:
        raise StepError("no token given")
    write_file(BRIDGE_CFG / "token", token + "\n", 0o600)
    write_file(BRIDGE_CFG / "env", f"HA_URL={url}\n", 0o600)


def adapter_appears() -> None:
    if DRY_RUN:
        return
    for attempt in range(2):
        for _ in range(15):
            if virtual_adapter():
                return
            time.sleep(1)
        if attempt == 0:
            run(["systemctl", "--user", "restart", "ha-ble-vhci"])
    tail = out(["journalctl", "--user", "-u", "ha-ble-vhci", "-n", "15", "--no-pager"])
    raise StepError("the virtual adapter did not appear. Service log:\n" + tail)


