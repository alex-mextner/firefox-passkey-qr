def ha_token() -> str | None:
    """A token that needs no question: ``$HA_TOKEN``, else an existing token file."""
    return os.environ.get("HA_TOKEN", "").strip() or (read_text(BRIDGE_CFG / "token") or "").strip() or None


def _hidden(prompt: str) -> str:
    log(f"{prompt}<hidden input, not logged>")
    return getpass.getpass(prompt).strip()


def configure_ha() -> None:
    url = ha_url_configured()
    stored = (read_text(BRIDGE_CFG / "token") or "").strip()
    if not url:
        say("  Looking for Home Assistant (ESPHome Bluetooth proxy) on LAN / Tailscale ...")
        found = ha_candidates()
        if found:
            say("  found: " + ", ".join(found))
        if found and confirm(f"Use Home Assistant at {found[0]}?"):
            url = found[0]
        elif not DRY_RUN and not ASSUME_YES:
            url = ask("  Home Assistant URL (e.g. http://100.x.y.z:8123), Enter to abort: ").strip().rstrip("/")
        if not url:
            blocked("No Bluetooth adapter and no Home Assistant found: plug in a USB Bluetooth (BLE) dongle, "
                    "or set HA_URL and HA_TOKEN and re-run")
        rejected = False
    else:
        rejected = bool(stored)
    if ASSUME_YES and DRY_RUN:
        token = "dry-run-token"  # the listing never asks for or prints a token
    elif ASSUME_YES:
        token = ha_token()
        if rejected and token == stored:
            token = None  # the stored token was just rejected; only a fresh $HA_TOKEN can fix it
        if not token:
            raise NeedsYou(f"Home Assistant at {url} needs a long-lived admin token: put it in $HA_TOKEN "
                           f"(or {BRIDGE_CFG / 'token'}) and re-run")
        say("  using the token from $HA_TOKEN or the token file; it is never printed")
    else:
        if rejected:
            say(f"  the stored token for {url} was rejected; enter a new one")
        say(f"  Create a long-lived token of an admin user: {url}/profile/security -> Long-lived access tokens")
        token = "dry-run-token" if DRY_RUN else _hidden("  Paste the token (hidden, Enter to abort): ")
    if not token:
        raise StepError("no token given")
    write_file(BRIDGE_CFG / "token", token + "\n", 0o600)
    write_file(BRIDGE_CFG / "env", f"HA_URL={url}\n", 0o600)


def adapter_appears() -> None:
    if DRY_RUN:
        return
    for attempt in range(2):
        for _ in range(15):
            if virtual_adapter():
                return
            time.sleep(1)
        if attempt == 0:
            run(["systemctl", "--user", "restart", "ha-ble-vhci"])
    tail = out(["journalctl", "--user", "-u", "ha-ble-vhci", "-n", "15", "--no-pager"])
    raise StepError("the virtual adapter did not appear. Service log:\n" + tail)


