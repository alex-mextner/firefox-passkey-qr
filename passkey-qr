class StepError(Exception):
    pass


# --------------------------------------------------------------------------- helpers
def say(msg: str = "") -> None:
    print(msg, flush=True)


def confirm(question: str, *, destructive: bool = False) -> bool:
    """Ask before a step. ``--yes`` answers for you and never prompts; a ``destructive`` step
    (removing the Firefox snap) additionally needs ``--remove-snap`` and is declined without it."""
    if destructive and ASSUME_YES and not REMOVE_SNAP:
        say(f"? {question} [no: --yes does not remove the snap without --remove-snap]")
        return False
    if ASSUME_YES:
        say(f"? {question} [yes: --yes]")
        return True
    if DRY_RUN:
        say(f"? {question} [auto-yes in dry-run]")
        return True
    while True:
        answer = input(f"? {question} [y/N] ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("", "n", "no"):
            return False


def _argv(cmd: list[str] | str, sudo: bool) -> list[str]:
    argv = shlex.split(cmd) if isinstance(cmd, str) else [str(a) for a in cmd]
    if sudo and os.geteuid() != 0:
        argv = ["sudo", *argv]
    return argv


def run(cmd: list[str] | str, *, sudo: bool = False, cwd: Path | None = None,
        check: bool = True) -> subprocess.CompletedProcess:
    argv = _argv(cmd, sudo)
    say("  $ " + " ".join(shlex.quote(a) for a in argv))
    if DRY_RUN:
        return subprocess.CompletedProcess(argv, 0, "", "")
    return subprocess.run(argv, cwd=cwd, check=check, text=True)


def run_stream(cmd: list[str] | str, *, cwd: Path | None = None, sudo: bool = False) -> tuple[int, str]:
    """Run a command, echo its output live and also return it."""
    argv = _argv(cmd, sudo)
    say("  $ " + " ".join(shlex.quote(a) for a in argv))
    if DRY_RUN:
        return 0, ""
    proc = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    lines: list[str] = []
    assert proc.stdout
    for line in proc.stdout:
        sys.stdout.write(line)
        lines.append(line)
    return proc.wait(), "".join(lines)


def out(cmd: list[str], timeout: float = 20) -> str:
    try:
        return subprocess.run([str(c) for c in cmd], capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def write_file(path: Path, content: str, mode: int = 0o644) -> None:
    say(f"  write {path} (mode {mode:o})")
    if DRY_RUN:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)


def sudo_write(path: Path, content: str) -> None:
    tmp = CACHE_DIR / "tmp" / path.name
    if not DRY_RUN:
        tmp.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text(content)
    run(["install", "-D", "-m0644", str(tmp), str(path)], sudo=True)


def read_text(path: Path) -> str | None:
    try:
        return path.read_text()
    except OSError:
        return None


def http(url: str, timeout: float = 3.0) -> int:
    try:
        with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as resp:
            return resp.status
    except urllib.error.HTTPError as err:
        return err.code
    except (urllib.error.URLError, OSError):
        return 0


@dataclass
class Action:
    name: str
    check: Callable[[], bool]
    apply: Callable[[], None]
    optional: bool = False  # confirmed separately; skipping it is not a failure
    destructive: bool = False  # with --yes it additionally needs --remove-snap
    hint: str = ""          # shown if the check still fails after apply


def show_actions(actions: list[Action]) -> list[Action]:
    pending = []
    for action in actions:
        ok = action.check()
        say(f"  [{'x' if ok else ' '}] {action.name}")
        if not ok:
            pending.append(action)
    return pending


def run_actions(title: str, actions: list[Action], intro: str = "") -> bool:
    say(f"\n== {title} ==")
    if intro:
        say(intro)
    pending = show_actions(actions)
    if not pending:
        say("  nothing to do")
        return True
    if not confirm(f"Apply the {len(pending)} unchecked action(s) above?"):
        say("  skipped")
        return False
    for action in pending:
        if action.check():  # an earlier action may already have fixed it
            continue
        if action.optional and not confirm(f"Optional: {action.name}?", destructive=action.destructive):
            say(f"  skipped: {action.name}")
            continue
        say(f"-> {action.name}")
        action.apply()
        if not DRY_RUN and not action.check():
            raise StepError(f"'{action.name}' was applied but the check still fails. {action.hint}".strip())
    return True


# --------------------------------------------------------------------------- packages
def installed_apt() -> set[str]:
    status = out(["dpkg-query", "-W", "-f=${Package} ${db:Status-Abbrev}\n"], timeout=60)
    return {line.split()[0] for line in status.splitlines() if line.endswith("ii ")}


def missing_apt() -> list[str]:
    have = installed_apt()
    return [p for p in APT_PACKAGES if p not in have]


def apt_install(pkgs: list[str], extra: list[str] | None = None) -> None:
    run(["apt-get", "install", "-y", *(extra or []), *pkgs], sudo=True)


# ----------------------------------------------------- automatic build-dependency fixing
DEP_PATTERNS: list[tuple[re.Pattern, str]] = [
    (re.compile(r'ERROR: Dependency "([^"]+)" not found'), "pc"),
    (re.compile(r"Package '?([\w.+-]+)'? was not found in the pkg-config search path"), "pc"),
    (re.compile(r"The system library `([\w.+-]+)` required by crate"), "pc"),
    (re.compile(r"ERROR: Program '([^']+)' not found"), "bin"),
    (re.compile(r"fatal error: ([\w./+-]+\.h): No such file or directory"), "hdr"),
]


def find_missing(text: str) -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    for pattern, kind in DEP_PATTERNS:
        for name in pattern.findall(text):
            if (kind, name) not in found:
                found.append((kind, name))
    return found


def apt_file_search(regex: str) -> list[str]:
    if not shutil.which("apt-file"):
        say("  apt-file is needed to find which package provides a missing file")
        apt_install(["apt-file"])
    if not any(Path("/var/cache/apt/apt-file").glob("*")):
        run(["apt-file", "update"], sudo=True)
    lines = out(["apt-file", "search", "--regexp", regex], timeout=120).splitlines()
    pkgs = [line.split(":")[0] for line in lines if ":" in line]
    pkgs = [p for p in pkgs if not p.endswith(("-dbgsym", "-doc"))]
    return sorted(pkgs, key=lambda p: (not p.endswith("-dev"), len(p)))[:1]


def resolve_packages(missing: list[tuple[str, str]]) -> list[str]:
    pkgs: list[str] = []
    for kind, name in missing:
        if name in PKG_OVERRIDES:
            found = [PKG_OVERRIDES[name]]
        elif kind == "pc":
            found = apt_file_search(rf"/pkgconfig/{re.escape(name)}\.pc$")
        elif kind == "bin":
            found = [name] if name in ("zip", "cargo", "rustc", "meson", "ninja") else \
                apt_file_search(rf"^/(usr/)?s?bin/{re.escape(name)}$")
        else:
            found = apt_file_search(rf"/usr/include/(.*/)?{re.escape(name)}$")
        say(f"  missing {kind} '{name}' -> {', '.join(found) or 'no package found'}")
        pkgs += [p for p in found if p not in pkgs]
    return pkgs


def run_resolving(cmd: list[str], cwd: Path, rounds: int = 30) -> None:
    """Run a build command; when it fails on a missing dependency, install it and retry."""
    tried: set[str] = set()
    for _ in range(rounds):
        rc, text = run_stream(cmd, cwd=cwd)
        if rc == 0:
            return
        have = installed_apt()
        pkgs = [p for p in resolve_packages(find_missing(text)) if p not in have]
        if not pkgs or set(pkgs) <= tried:
            tail = "\n".join(text.splitlines()[-15:])
            raise StepError(f"`{' '.join(cmd)}` failed and no installable dependency could be identified:\n{tail}")
        if not confirm(f"Install the missing build dependencies ({' '.join(pkgs)}) with apt?"):
            raise StepError("build dependencies not installed")
        apt_install(pkgs)
        tried |= set(pkgs)
    raise StepError(f"`{' '.join(cmd)}` still failing after {rounds} rounds of installing dependencies")


# --------------------------------------------------------------------------- bluetooth state
def bt_adapters() -> list[str]:
    return sorted(p.name for p in BLUETOOTH_DIR.glob("hci*")) if BLUETOOTH_DIR.exists() else []


def is_virtual(adapter: str) -> bool:
    return "/virtual/" in str((BLUETOOTH_DIR / adapter).resolve())


def virtual_adapter() -> str | None:
    return next((a for a in bt_adapters() if is_virtual(a)), None)


def real_adapters() -> list[str]:
    return [a for a in bt_adapters() if not is_virtual(a)]


def service_active(unit: str, user: bool = False) -> bool:
    return out(["systemctl", *(["--user"] if user else []), "is-active", unit]) == "active"


def ha_url_configured() -> str | None:
    text = read_text(BRIDGE_CFG / "env") or ""
    match = re.search(r"^HA_URL=(\S+)", text, re.M)
    return match.group(1) if match else None


def ha_candidates() -> list[str]:
    if os.environ.get("HA_URL"):
        return [os.environ["HA_URL"].rstrip("/")]
    hosts = ["homeassistant.local"]
    ts = out(["tailscale", "status", "--json"])
    if ts:
        try:
            for peer in (json.loads(ts).get("Peer") or {}).values():
                if peer.get("Online") and peer.get("TailscaleIPs"):
                    hosts.append(peer["TailscaleIPs"][0])
        except json.JSONDecodeError:
            pass
    found = []
    for host in hosts:
        try:
            with socket.create_connection((host, 8123), timeout=1.5):
                if http(f"http://{host}:8123/api/") in (200, 401):
                    found.append(f"http://{host}:8123")
        except OSError:
            continue
    return found


BRIDGE_BIN = BRIDGE_DIR / "venv/bin/ha-ble-vhci"


def bridge_current() -> bool:
    pip = BRIDGE_DIR / "venv/bin/pip"
    if not (pip.exists() and BRIDGE_BIN.exists()):
        return False
    match = re.search(r"^Version: (\S+)", out([str(pip), "show", "ha-ble-vhci"]), re.M)
    return bool(match) and match.group(1) == BRIDGE_VERSION


def ha_valid() -> bool:
    url = ha_url_configured()
    token = BRIDGE_CFG / "token"
    if not (BRIDGE_BIN.exists() and url and token.exists()):
        return False
    try:
        return subprocess.run([str(BRIDGE_BIN), "--check", "--url", url, "--token-file", str(token)],
                              capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def bridge_unit_text() -> str:
    return (
        "[Unit]\nDescription=Home Assistant Bluetooth proxies as a local scan-only hciN\n"
        "After=network-online.target\nWants=network-online.target\n\n"
        f"[Service]\nEnvironmentFile=-{BRIDGE_CFG}/env\nExecStart={BRIDGE_BIN}\n"
        "Restart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=default.target\n"
    )


def install_bridge() -> None:
    venv = BRIDGE_DIR / "venv"
    run([sys.executable, "-m", "venv", "--without-pip", str(venv)])
    if not DRY_RUN and not (venv / "bin/pip").exists():
        getpip = CACHE_DIR / "get-pip.py"
        getpip.parent.mkdir(parents=True, exist_ok=True)
        run(["curl", "-fsSL", "https://bootstrap.pypa.io/get-pip.py", "-o", str(getpip)])
        run([str(venv / "bin/python"), str(getpip), "-q"])
    run([str(venv / "bin/pip"), "install", "-q", "--upgrade", f"git+{BRIDGE_REPO}"])
    if service_active("ha-ble-vhci", user=True):
        run(["systemctl", "--user", "restart", "ha-ble-vhci"])  # pick up the new version


def ha_token() -> str | None:
    """A token that needs no question: ``$HA_TOKEN``, else an existing token file."""
    return os.environ.get("HA_TOKEN", "").strip() or (read_text(BRIDGE_CFG / "token") or "").strip() or None


def configure_ha() -> None:
    url = ha_url_configured()
    stored = (read_text(BRIDGE_CFG / "token") or "").strip()
    if not url:
        say("  Looking for Home Assistant (ESPHome Bluetooth proxy) on LAN / Tailscale ...")
        found = ha_candidates()
        if found:
            say("  found: " + ", ".join(found))
        if found and confirm(f"Use Home Assistant at {found[0]}?"):
            url = found[0]
        elif not DRY_RUN and not ASSUME_YES:
            url = input("  Home Assistant URL (e.g. http://100.x.y.z:8123), Enter to abort: ").strip().rstrip("/")
        if not url:
            raise StepError("No Home Assistant configured: plug in a USB Bluetooth (BLE) dongle instead.")
        rejected = False
    else:
        rejected = bool(stored)
    if ASSUME_YES:
        token = ha_token()
        if rejected and token == stored:
            token = None  # the stored token was just rejected; only a fresh $HA_TOKEN can fix it
        if not token:
            raise StepError(f"--yes cannot ask for a token: put a valid one in $HA_TOKEN "
                            f"(or {BRIDGE_CFG / 'token'}) and re-run")
        say("  using the token from $HA_TOKEN or the token file; it is never printed")
    else:
        if rejected:
            say(f"  the stored token for {url} was rejected; enter a new one")
        say(f"  Create a long-lived token of an admin user: {url}/profile/security -> Long-lived access tokens")
        token = "dry-run-token" if DRY_RUN else getpass.getpass("  Paste the token (hidden, Enter to abort): ").strip()
    if not token:
        raise StepError("no token given")
    write_file(BRIDGE_CFG / "token", token + "\n", 0o600)
    write_file(BRIDGE_CFG / "env", f"HA_URL={url}\n", 0o600)


def adapter_appears() -> None:
    for attempt in range(2):
        for _ in range(15):
            if virtual_adapter():
                return
            time.sleep(1)
        if attempt == 0:
            run(["systemctl", "--user", "restart", "ha-ble-vhci"])
    tail = out(["journalctl", "--user", "-u", "ha-ble-vhci", "-n", "15", "--no-pager"])
    raise StepError("the virtual adapter did not appear. Service log:\n" + tail)


def bluetooth_actions() -> list[Action]:
    return [
        Action(f"ha-ble-vhci {BRIDGE_VERSION} installed", bridge_current, install_bridge),
        Action("Home Assistant URL + token stored", lambda: bool(ha_url_configured()) and (BRIDGE_CFG / "token").exists(), configure_ha),
        Action("Home Assistant reachable, token valid and admin", ha_valid, configure_ha,
               hint="Check the URL/token (the token must belong to an admin user)."),
        Action("udev rule + hci_vhci autoload",
               lambda: read_text(UDEV_RULE) == UDEV_RULE_TEXT and (read_text(MODULES_CONF) or "").strip() == "hci_vhci",
               lambda: (sudo_write(UDEV_RULE, UDEV_RULE_TEXT), sudo_write(MODULES_CONF, "hci_vhci\n"))),
        Action("/dev/vhci exists (hci_vhci loaded)", lambda: Path("/dev/vhci").exists(),
               lambda: run(["modprobe", "hci_vhci"], sudo=True)),
        Action("/dev/vhci usable by you", lambda: os.access("/dev/vhci", os.R_OK | os.W_OK),
               lambda: (run(["udevadm", "control", "--reload"], sudo=True), run(["udevadm", "trigger"], sudo=True)),
               hint="Log out and back in once (so the new device ACL / plugdev membership applies), then re-run."),
        Action("bluetooth.service running", lambda: service_active("bluetooth"),
               lambda: run(["systemctl", "enable", "--now", "bluetooth"], sudo=True)),
        Action("ha-ble-vhci user service running",
               lambda: BRIDGE_UNIT.exists() and service_active("ha-ble-vhci", user=True)
               and out(["systemctl", "--user", "is-enabled", "ha-ble-vhci"]) == "enabled",
               lambda: (write_file(BRIDGE_UNIT, bridge_unit_text()),
                        run(["systemctl", "--user", "daemon-reload"]),
                        run(["systemctl", "--user", "enable", "ha-ble-vhci"]),
                        run(["systemctl", "--user", "restart", "ha-ble-vhci"]))),
        Action("virtual Bluetooth adapter registered", lambda: virtual_adapter() is not None,
               adapter_appears),
        Action("adapter powered on", lambda: "Powered: yes" in out(["bluetoothctl", "show"]),
               lambda: run(["bluetoothctl", "power", "on"], check=False)),
    ]


# --------------------------------------------------------------------------- firefox
def deb_firefox_installed() -> bool:
    version = out(["dpkg-query", "-W", "-f=${Version}", "firefox"])
    return Path("/usr/lib/firefox/firefox").exists() and bool(version) and "snap" not in version


def snap_firefox_present() -> bool:
    return Path("/snap/firefox/current").exists()


def firefox_running() -> bool:
    return bool(out(["pgrep", "-x", "firefox"]) or out(["pgrep", "-f", "/snap/firefox/"]))


def mozilla_repo_ok() -> bool:
    return (MOZ_KEY.exists() and MOZ_LIST.exists() and MOZ_PIN.exists()
            and "packages.mozilla.org" in out(["apt-cache", "policy", "firefox"], timeout=60))


def snap_profile() -> Path | None:
    ini = SNAP_PROFILE / "profiles.ini"
    if not ini.exists():
        return None
    cp = configparser.ConfigParser()
    cp.read(ini)
    paths = [(s.get("Path"), s.get("Default") == "1") for n, s in cp.items() if n.startswith("Profile") and s.get("Path")]
    paths.sort(key=lambda t: not t[1])
    for rel, _ in paths:
        if (SNAP_PROFILE / rel).is_dir():
            return SNAP_PROFILE / rel
    return None


def profile_copied() -> bool:
    prof = snap_profile()
    return prof is None or (MOZ_PROFILE / prof.name / "prefs.js").exists()


def install_mozilla_repo() -> None:
    run(["install", "-d", "-m0755", "/etc/apt/keyrings"], sudo=True)
    run(["curl", "-fsSL", "https://packages.mozilla.org/apt/repo-signing-key.gpg", "-o", str(MOZ_KEY)], sudo=True)
    sudo_write(MOZ_LIST, f"deb [signed-by={MOZ_KEY}] https://packages.mozilla.org/apt mozilla main\n")
    sudo_write(MOZ_PIN, "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n")
    run(["apt-get", "update"], sudo=True)


def copy_profile() -> None:
    prof = snap_profile()
    assert prof
    if firefox_running() and ASSUME_YES and not DRY_RUN:
        raise StepError("Firefox is running and --yes cannot ask you to close it: close it and re-run")
    while firefox_running() and not DRY_RUN:
        input("  Close Firefox completely, then press Enter... ")
    run(["rsync", "-a", f"{prof}/", f"{MOZ_PROFILE / prof.name}/"])
    if not (MOZ_PROFILE / "profiles.ini").exists():
        run(["cp", str(SNAP_PROFILE / "profiles.ini"), str(MOZ_PROFILE / "profiles.ini")])
    if not DRY_RUN:
        for lock in ("lock", ".parentlock"):
            (MOZ_PROFILE / prof.name / lock).unlink(missing_ok=True)


def firefox_actions() -> list[Action]:
    return [
        Action("Mozilla apt repo + pin (so apt does not bring the snap back)", mozilla_repo_ok, install_mozilla_repo),
        Action("Firefox deb installed",
               deb_firefox_installed,
               # Ubuntu's transitional package has epoch 1:, so Mozilla's deb counts as a downgrade
               lambda: apt_install(["firefox"], extra=["--allow-downgrades"])),
        Action("snap profile copied to ~/.mozilla/firefox", profile_copied, copy_profile),
        Action("Firefox snap removed (snapd keeps an automatic snapshot)", lambda: not snap_firefox_present(),
               lambda: run(["snap", "remove", "firefox"], sudo=True), optional=True, destructive=True),
    ]


# --------------------------------------------------------------------------- credentialsd + portal
@dataclass
class Project:
    name: str
    repo: str
    ref: str
    is_tag: bool
    recurse: bool
    setup: list[str]
    build_dir: str

    @property
    def path(self) -> Path:
        return SRC_DIR / self.name

    @property
    def build(self) -> Path:
        return self.path / self.build_dir


PROJECTS = [
    Project("credentialsd", CREDSD_REPO, CREDSD_TAG, True, False, ["-Dprefix=/usr/local"], "build-release"),
    Project("xdg-desktop-portal", PORTAL_REPO, PORTAL_BRANCH, False, True, ["--prefix", "/usr/local"], "_build"),
]


def git_out(path: Path, *args: str) -> str:
    return out(["git", "-C", str(path), *args])


def source_ready(p: Project) -> bool:
    if not (p.path / ".git").exists():
        return False
    at_ref = (git_out(p.path, "describe", "--tags", "--exact-match") == p.ref if p.is_tag
              else git_out(p.path, "rev-parse", "--abbrev-ref", "HEAD") == p.ref)
    subs = git_out(p.path, "submodule", "status", "--recursive").splitlines() if p.recurse else []
    return at_ref and not any(line[:1] in "-+U" for line in subs)


def fetch_source(p: Project) -> None:
    if (p.path / ".git").exists():
        run(["git", "-C", str(p.path), "fetch", "--tags", "origin"])
    else:
        p.path.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", *(["--recurse-submodules"] if p.recurse else []), p.repo, str(p.path)])
    run(["git", "-C", str(p.path), "checkout", p.ref])
    if p.recurse:
        run(["git", "-C", str(p.path), "submodule", "update", "--init", "--recursive"])


def installed_map(p: Project) -> dict[str, str]:
    if not (p.build / "meson-private").exists():
        return {}
    try:
        return json.loads(out(["meson", "introspect", "--installed", str(p.build)], timeout=60))
    except json.JSONDecodeError:
        return {}


def is_installed(p: Project) -> bool:
    files = installed_map(p)
    return bool(files) and all(os.path.lexists(dest) for dest in files.values())


def is_built(p: Project) -> bool:
    if is_installed(p):
        return True
    files = installed_map(p)
    return bool(files) and all(os.path.lexists(src) for src in files if src.startswith(str(p.build)))


def build_project(p: Project) -> None:
    run_resolving(["meson", "setup", *p.setup, p.build_dir, "--reconfigure"], p.path)
    run_resolving(["meson", "compile", "-C", p.build_dir], p.path)


def credentialsd_actions() -> list[Action]:
    actions: list[Action] = []
    for p in PROJECTS:
        actions += [
            Action(f"{p.name}: source at {p.ref}" + (" with submodules" if p.recurse else ""),
                   lambda p=p: source_ready(p), lambda p=p: fetch_source(p)),
            Action(f"{p.name}: built (missing build dependencies are installed automatically)",
                   lambda p=p: is_built(p), lambda p=p: build_project(p)),
            Action(f"{p.name}: installed into /usr/local", lambda p=p: is_installed(p),
                   lambda p=p: run(["meson", "install", "-C", p.build_dir], cwd=p.path, sudo=True)),
        ]
    actions.append(Action("xdg-desktop-portal: credential portal enabled (systemd user drop-in)",
                          lambda: read_text(PORTAL_DROPIN) == PORTAL_DROPIN_TEXT,
                          lambda: (write_file(PORTAL_DROPIN, PORTAL_DROPIN_TEXT),
                                   run(["systemctl", "--user", "daemon-reload"]))))
    return actions


# --------------------------------------------------------------------------- extension
def nm_link() -> Path:
    return HOME / ".mozilla/native-messaging-hosts" / NM_MANIFEST


def nm_target() -> Path:
    lib64 = Path("/usr/local/lib64")
    libdir = lib64 if lib64.is_dir() and not lib64.is_symlink() else Path("/usr/local/lib")
    return libdir / "mozilla/native-messaging-hosts" / NM_MANIFEST


def nm_ok() -> bool:
    link = nm_link()
    return link.is_symlink() and link.exists()


def link_nm() -> None:
    if not DRY_RUN:
        nm_link().parent.mkdir(parents=True, exist_ok=True)
    run(["ln", "-sfn", str(nm_target()), str(nm_link())])


def extension_in_profile() -> bool:
    for ext_json in MOZ_PROFILE.glob("*/extensions.json"):
        try:
            for addon in json.loads(ext_json.read_text()).get("addons", []):
                if addon.get("id") == XPI_ID and addon.get("active"):
                    return True
        except (OSError, json.JSONDecodeError):
            continue
    return False


def policy_data() -> dict:
    try:
        return json.loads(FIREFOX_POLICIES.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def policy_ok() -> bool:
    entry = policy_data().get("policies", {}).get("ExtensionSettings", {}).get(XPI_ID, {})
    return entry.get("installation_mode") == "normal_installed" and entry.get("install_url") == XPI_URL


def install_policy() -> None:
    data = policy_data()
    data.setdefault("policies", {}).setdefault("ExtensionSettings", {})[XPI_ID] = {
        "installation_mode": "normal_installed",  # installed for you, but you can still disable/remove it
        "install_url": XPI_URL,
    }
    sudo_write(FIREFOX_POLICIES, json.dumps(data, indent=2) + "\n")


def extension_actions() -> list[Action]:
    return [
        Action("native-messaging host linked for Firefox (replaces a manual manifest)", nm_ok, link_nm,
               hint=f"{nm_target()} is missing: the credentialsd install step has to succeed first."),
        Action("Firefox policy installs the signed extension on next start", policy_ok, install_policy),
    ]


# --------------------------------------------------------------------------- steps
def packages_actions() -> list[Action]:
    return [Action("all required apt packages installed", lambda: not missing_apt(), lambda: apt_install(missing_apt()))]


def step_packages() -> bool:
    return run_actions("1. Build and runtime packages", packages_actions())


def step_firefox() -> bool:
    return run_actions("2. Firefox (non-snap)", firefox_actions(),
                       "  The snap sandbox blocks the native-messaging host the extension needs.")


def step_bluetooth() -> bool:
    if real_adapters():
        say("\n== 3. Bluetooth for the QR (hybrid) flow ==")
        say("  local adapter(s) present: " + ", ".join(real_adapters()) + " - nothing to do")
        return True
    return run_actions(
        "3. Bluetooth for the QR (hybrid) flow", bluetooth_actions(),
        "  No physical Bluetooth adapter. The QR flow needs the PC to hear the phone's BLE advert;\n"
        "  ha-ble-vhci provides that from a Home Assistant Bluetooth proxy.")


def step_credentialsd() -> bool:
    return run_actions("4. credentialsd + patched xdg-desktop-portal", credentialsd_actions(),
                       "  Built from source into /usr/local; this takes a while.")


def step_extension() -> bool:
    return run_actions("5. Firefox extension + native-messaging host", extension_actions())


STEPS = [step_packages, step_firefox, step_bluetooth, step_credentialsd, step_extension]


def status_groups() -> list[tuple[str, list[Action]]]:
    """The step groups with their actions; step 3 has none when a physical adapter is present."""
    return [
        ("1. Packages", packages_actions()),
        ("2. Firefox", firefox_actions()),
        ("3. Bluetooth via Home Assistant", [] if real_adapters() else bluetooth_actions()),
        ("4. credentialsd + portal", credentialsd_actions()),
        ("5. Extension", extension_actions()),
    ]


def cmd_status(_: argparse.Namespace) -> None:
    for title, actions in status_groups():
        if title.startswith("3.") and real_adapters():
            say("\n== 3. Bluetooth ==\n  local adapter(s): " + ", ".join(real_adapters()))
            continue
        say(f"\n== {title} ==")
        show_actions(actions)
    missing = missing_apt()
    if missing:
        say("\n  missing packages: " + " ".join(missing))


def status_rows() -> list[tuple[str, bool, bool]]:
    """``(label, ok, required)``: ``required`` rows decide ``check``; the others are context.
    Bluetooth is one required row (any adapter, local or ha-ble-vhci); how it is provided is context."""
    rows = [("Bluetooth adapter (local or ha-ble-vhci)", bool(bt_adapters()), True)]
    for title, actions in status_groups():
        if title.startswith("3."):
            rows += [(a.name, a.check(), False) for a in actions]
        else:
            rows += [(a.name, a.check(), not a.optional) for a in actions]
    return rows


def cmd_check(_: argparse.Namespace) -> None:
    """Read-only: exit 0 when every required row holds, 3 (and the unmet rows) otherwise."""
    unmet = [label for label, ok, required in status_rows() if required and not ok]
    for label in unmet:
        say(f"  missing: {label}")
    sys.exit(3 if unmet else 0)


def cmd_install(_: argparse.Namespace) -> None:
    say("passkey-qr changes your system step by step; "
        + ("--yes answers every step for you" if ASSUME_YES else "every step asks first")
        + ", and anything already\napplied (checked against the real system state) is skipped.")
    for step in STEPS:
        step()
    say("\nFinal state:")
    cmd_status(argparse.Namespace())
    say(f"  extension active in your Firefox profile: {'yes' if extension_in_profile() else 'not yet (restart Firefox)'}")
    say("\nNext: restart Firefox, open about:addons -> credentialsd-helper -> Permissions and allow all sites,\n"
        "then test at https://webauthn.io (register/sign in, choose the phone/QR option).")


def main() -> None:
    global DRY_RUN, ASSUME_YES, REMOVE_SNAP
    parser = argparse.ArgumentParser(prog="passkey-qr", description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true", help="print the commands, change nothing, auto-answer yes")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="answer yes to every step and never prompt (a token must be in $HA_TOKEN or the "
                             "token file; the Firefox snap is kept unless --remove-snap)")
    parser.add_argument("--remove-snap", action="store_true",
                        help="with --yes, also remove the Firefox snap after the deb is installed")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="show which actions are really applied").set_defaults(func=cmd_status)
    sub.add_parser("check", help="exit 0 when everything required is in place, 3 otherwise (read-only)"
                   ).set_defaults(func=cmd_check)
    sub.add_parser("install", help="apply everything that is missing").set_defaults(func=cmd_install)
    args = parser.parse_args()
    DRY_RUN, ASSUME_YES, REMOVE_SNAP = args.dry_run, args.yes, args.remove_snap
    try:
        args.func(args)
    except StepError as err:
        sys.exit(f"\nstopped: {err}\nFix the cause and re-run `passkey-qr install`: finished actions are skipped.")
    except subprocess.CalledProcessError as err:
        sys.exit(f"\ncommand failed (exit {err.returncode}): {' '.join(map(str, err.cmd))}\n"
                 "Re-run `passkey-qr install` after fixing it: finished actions are skipped.")
    except (KeyboardInterrupt, EOFError):
        sys.exit("\naborted")


if __name__ == "__main__":
    main()
