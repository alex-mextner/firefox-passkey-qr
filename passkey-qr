#!/usr/bin/env python3
"""passkey-qr: make Firefox on Ubuntu offer "use your phone (QR)" for passkeys.

The entry point only; the program is the `passkey_qr` package next to this file (passkey_qr/cli.py has the
overview and the command line).
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # resolve(): a symlink to this file still finds the package

from passkey_qr import cli

if __name__ == "__main__":
    cli.main()
