# --------------------------------------------------------------------------- helpers
STATE_DIR = Path(os.environ.get("PASSKEY_QR_STATE", HOME / ".local/state/passkey-qr"))
LOG_FILE = None  # opened by init_log()


def init_log(command: str) -> Path:
    """Mirror everything shown on screen (and all command output) into a log file."""
    global LOG_FILE
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path = STATE_DIR / f"{time.strftime('%Y%m%d-%H%M%S')}-{command}.log"
    LOG_FILE = open(path, "a", buffering=1)
    if command == "install":  # latest.log always points to the last install run
        latest = STATE_DIR / "latest.log"
        latest.unlink(missing_ok=True)
        latest.symlink_to(path.name)
    log(f"passkey-qr {command} started {time.strftime('%Y-%m-%d %H:%M:%S')} dry_run={DRY_RUN} user={getpass.getuser()}")
    return path


def log(text: str) -> None:
    if LOG_FILE:
        LOG_FILE.write(text if text.endswith("\n") else text + "\n")


def say(msg: str = "") -> None:
    print(msg, flush=True)
    log(msg)


def ask(prompt: str) -> str:
    log(f"{prompt}<waiting for input>")
    answer = input(prompt)
    log(f"  -> {answer!r}")
    return answer


def confirm(question: str) -> bool:
    if DRY_RUN:
        say(f"? {question} [auto-yes in dry-run]")
        return True
    while True:
        answer = ask(f"? {question} [y/N] ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("", "n", "no"):
            return False


def _argv(cmd: list[str] | str, sudo: bool) -> list[str]:
    argv = shlex.split(cmd) if isinstance(cmd, str) else [str(a) for a in cmd]
    if sudo and os.geteuid() != 0:
        argv = ["sudo", *argv]
    return argv


def run_stream(cmd: list[str] | str, *, cwd: Path | None = None, sudo: bool = False) -> tuple[int, str]:
    """Run a command, echo its output live (screen and log) and also return it."""
    argv = _argv(cmd, sudo)
    say("  $ " + " ".join(shlex.quote(a) for a in argv))
    if DRY_RUN:
        return 0, ""
    started = time.time()
    proc = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            errors="replace")
    lines: list[str] = []
    assert proc.stdout
    for line in proc.stdout:
        sys.stdout.write(line)
        log(line)
        lines.append(line)
    rc = proc.wait()
    log(f"  [exit {rc} after {time.time() - started:.1f}s]")
    return rc, "".join(lines)


def run(cmd: list[str] | str, *, sudo: bool = False, cwd: Path | None = None,
        check: bool = True) -> subprocess.CompletedProcess:
    argv = _argv(cmd, sudo)
    rc, text = run_stream(cmd, cwd=cwd, sudo=sudo)
    if check and rc != 0:
        raise subprocess.CalledProcessError(rc, argv, output=text)
    return subprocess.CompletedProcess(argv, rc, text, "")


def out(cmd: list[str], timeout: float = 20) -> str:
    try:
        return subprocess.run([str(c) for c in cmd], capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def write_file(path: Path, content: str, mode: int = 0o644) -> None:
    say(f"  write {path} (mode {mode:o})")
    if DRY_RUN:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)


def sudo_write(path: Path, content: str) -> None:
    tmp = CACHE_DIR / "tmp" / path.name
    if not DRY_RUN:
        tmp.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text(content)
    run(["install", "-D", "-m0644", str(tmp), str(path)], sudo=True)


def read_text(path: Path) -> str | None:
    try:
        return path.read_text()
    except OSError:
        return None


def http(url: str, timeout: float = 3.0) -> int:
    try:
        with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as resp:
            return resp.status
    except urllib.error.HTTPError as err:
        return err.code
    except (urllib.error.URLError, OSError):
        return 0


@dataclass
class Action:
    name: str
    check: Callable[[], bool]
    apply: Callable[[], None]
    optional: bool = False  # confirmed separately; skipping it is not a failure
    hint: str = ""          # shown if the check still fails after apply


def show_actions(actions: list[Action]) -> list[Action]:
    pending = []
    for action in actions:
        ok = action.check()
        say(f"  [{'x' if ok else ' '}] {action.name}")
        if not ok:
            pending.append(action)
    return pending


def run_actions(title: str, actions: list[Action], intro: str = "") -> bool:
    say(f"\n== {title} ==")
    if intro:
        say(intro)
    pending = show_actions(actions)
    if not pending:
        say("  nothing to do")
        return True
    if not confirm(f"Apply the {len(pending)} unchecked action(s) above?"):
        say("  skipped")
        return False
    for action in pending:
        if action.check():  # an earlier action may already have fixed it
            continue
        if action.optional and not confirm(f"Optional: {action.name}?"):
            say(f"  skipped: {action.name}")
            continue
        say(f"-> {action.name}")
        action.apply()
        if not DRY_RUN and not action.check():
            raise StepError(f"'{action.name}' was applied but the check still fails. {action.hint}".strip())
    return True


# --------------------------------------------------------------------------- packages
def installed_apt() -> set[str]:
    status = out(["dpkg-query", "-W", "-f=${Package} ${db:Status-Abbrev}\n"], timeout=60)
    return {line.split()[0] for line in status.splitlines() if line.endswith("ii ")}


def missing_apt() -> list[str]:
    have = installed_apt()
    return [p for p in APT_PACKAGES if p not in have]


def apt_install(pkgs: list[str], extra: list[str] | None = None) -> None:
    run(["apt-get", "install", "-y", *(extra or []), *pkgs], sudo=True)


# ----------------------------------------------------- automatic build-dependency fixing
DEP_PATTERNS: list[tuple[re.Pattern, str]] = [
    (re.compile(r'ERROR: Dependency "([^"]+)" not found'), "pc"),
    (re.compile(r"Package '?([\w.+-]+)'? was not found in the pkg-config search path"), "pc"),
    (re.compile(r"The system library `([\w.+-]+)` required by crate"), "pc"),
    (re.compile(r"Program ([\w.+-]+) found: NO found [\d.]+ but need"), "tool"),
    (re.compile(r"ERROR: Program '([^']+)' not found"), "bin"),
    (re.compile(r"fatal error: ([\w./+-]+\.h): No such file or directory"), "hdr"),
    (re.compile(r"fatal error: '([\w./+-]+\.h)' file not found"), "hdr"),
    (re.compile(r"\b(\w+) is not in PATH"), "bin"),
]


def find_missing(text: str) -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    for pattern, kind in DEP_PATTERNS:
        for name in pattern.findall(text):
            if (kind, name) not in found:
                found.append((kind, name))
    return found


def apt_file_search(regex: str) -> list[str]:
    if not shutil.which("apt-file"):
        say("  apt-file is needed to find which package provides a missing file")
        apt_install(["apt-file"])
    if not any(Path("/var/cache/apt/apt-file").glob("*")):
        run(["apt-file", "update"], sudo=True)
    lines = out(["apt-file", "search", "--regexp", regex], timeout=120).splitlines()
    pkgs = [line.split(":")[0] for line in lines if ":" in line]
    pkgs = [p for p in pkgs if not p.endswith(("-dbgsym", "-doc"))]
    return sorted(pkgs, key=lambda p: (not p.endswith("-dev"), len(p)))[:1]


def resolve_packages(missing: list[tuple[str, str]]) -> list[str]:
    pkgs: list[str] = []
    for kind, name in missing:
        if name in PKG_OVERRIDES:
            found = [PKG_OVERRIDES[name]]
        elif kind == "pc":
            found = apt_file_search(rf"/pkgconfig/{re.escape(name)}\.pc$")
        elif kind == "bin":
            found = [name] if name in ("zip", "cargo", "rustc", "meson", "ninja") else \
                apt_file_search(rf"^/(usr/)?s?bin/{re.escape(name)}$")
        else:
            found = apt_file_search(rf"/usr/include/(.*/)?{re.escape(name)}$")
        say(f"  missing {kind} '{name}' -> {', '.join(found) or 'no package found'}")
        pkgs += [p for p in found if p not in pkgs]
    return pkgs


def version_of(tool: str) -> tuple[int, ...]:
    match = re.search(r"(\d+(?:\.\d+)+)", out([tool, "--version"]))
    return tuple(int(part) for part in match.group(1).split(".")) if match else ()


def ensure_local_bin_on_path() -> None:
    parts = os.environ.get("PATH", "").split(":")
    for directory in (str(CARGO_BIN), str(LOCAL_BIN)):
        if directory not in parts[:2]:
            parts = [directory] + [p for p in parts if p != directory]
    os.environ["PATH"] = ":".join(parts)


def blueprint_ok() -> bool:
    ensure_local_bin_on_path()
    return version_of("blueprint-compiler") >= BLUEPRINT_MIN


def build_blueprint() -> None:
    """Ubuntu's blueprint-compiler is too old for credentialsd-ui: build the pinned release into ~/.local."""
    src = SRC_DIR / "blueprint-compiler"
    if (src / ".git").exists():
        run(["git", "-C", str(src), "fetch", "--tags", "origin"])
    else:
        src.parent.mkdir(parents=True, exist_ok=True) if not DRY_RUN else None
        run(["git", "clone", BLUEPRINT_REPO, str(src)])
    run(["git", "-C", str(src), "checkout", BLUEPRINT_TAG])
    run_resolving(["meson", "setup", "_build", "--prefix", str(HOME / ".local"), "--reconfigure"], src)
    run_resolving(["meson", "compile", "-C", "_build"], src)
    run(["meson", "install", "-C", "_build"], cwd=src)  # user prefix: no sudo
    ensure_local_bin_on_path()


SOURCE_BUILDERS: dict[str, Callable[[], None]] = {"blueprint-compiler": build_blueprint}


def run_resolving(cmd: list[str], cwd: Path, rounds: int = 30) -> None:
    """Run a build command; when it fails on a missing dependency, install it and retry."""
    tried: set[str] = set()
    for _ in range(rounds):
        rc, text = run_stream(cmd, cwd=cwd)
        if rc == 0:
            return
        missing = find_missing(text)
        wanted = [name for _, name in missing if name in SOURCE_BUILDERS and name not in tried]
        if wanted:  # tools Ubuntu ships too old: build the pinned release instead of apt
            if not confirm(f"{', '.join(wanted)} must be built from source into ~/.local (Ubuntu's is too old). Do it?"):
                raise StepError("source-built tool declined")
            for name in wanted:
                SOURCE_BUILDERS[name]()
                tried.add(name)
            continue
        have = installed_apt()
        pkgs = [p for p in resolve_packages([m for m in missing if m[1] not in SOURCE_BUILDERS]) if p not in have]
        if not pkgs or set(pkgs) <= tried:
            lines = text.splitlines()
            errs = [l for l in lines if re.search(r"error|ERROR|FAILED|panicked|not found", l)][:25]
            tail = "\n".join(errs + ["...", *lines[-8:]])
            raise StepError(f"`{' '.join(cmd)}` failed and no installable dependency could be identified:\n{tail}")
        if not confirm(f"Install the missing build dependencies ({' '.join(pkgs)}) with apt?"):
            raise StepError("build dependencies not installed")
        apt_install(pkgs)
        tried |= set(pkgs)
    raise StepError(f"`{' '.join(cmd)}` still failing after {rounds} rounds of installing dependencies")


# --------------------------------------------------------------------------- bluetooth state
def bt_adapters() -> list[str]:
    base = Path("/sys/class/bluetooth")
    return sorted(p.name for p in base.glob("hci*")) if base.exists() else []


def is_virtual(adapter: str) -> bool:
    return "/virtual/" in str((Path("/sys/class/bluetooth") / adapter).resolve())


def virtual_adapter() -> str | None:
    return next((a for a in bt_adapters() if is_virtual(a)), None)


def real_adapters() -> list[str]:
    return [a for a in bt_adapters() if not is_virtual(a)]


def service_active(unit: str, user: bool = False) -> bool:
    return out(["systemctl", *(["--user"] if user else []), "is-active", unit]) == "active"


def ha_url_configured() -> str | None:
    text = read_text(BRIDGE_CFG / "env") or ""
    match = re.search(r"^HA_URL=(\S+)", text, re.M)
    return match.group(1) if match else None


def ha_candidates() -> list[str]:
    if os.environ.get("HA_URL"):
        return [os.environ["HA_URL"].rstrip("/")]
    hosts = ["homeassistant.local"]
    ts = out(["tailscale", "status", "--json"])
    if ts:
        try:
            for peer in (json.loads(ts).get("Peer") or {}).values():
                if peer.get("Online") and peer.get("TailscaleIPs"):
                    hosts.append(peer["TailscaleIPs"][0])
        except json.JSONDecodeError:
            pass
    found = []
    for host in hosts:
        try:
            with socket.create_connection((host, 8123), timeout=1.5):
                if http(f"http://{host}:8123/api/") in (200, 401):
                    found.append(f"http://{host}:8123")
        except OSError:
            continue
    return found


BRIDGE_BIN = BRIDGE_DIR / "venv/bin/ha-ble-vhci"


def bridge_current() -> bool:
    pip = BRIDGE_DIR / "venv/bin/pip"
    if not (pip.exists() and BRIDGE_BIN.exists()):
        return False
    match = re.search(r"^Version: (\S+)", out([str(pip), "show", "ha-ble-vhci"]), re.M)
    return bool(match) and match.group(1) == BRIDGE_VERSION


def ha_valid() -> bool:
    url = ha_url_configured()
    token = BRIDGE_CFG / "token"
    if not (BRIDGE_BIN.exists() and url and token.exists()):
        return False
    try:
        return subprocess.run([str(BRIDGE_BIN), "--check", "--url", url, "--token-file", str(token)],
                              capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def bridge_unit_text() -> str:
    return (
        "[Unit]\nDescription=Home Assistant Bluetooth proxies as a local scan-only hciN\n"
        "After=network-online.target\nWants=network-online.target\n\n"
        f"[Service]\nEnvironmentFile=-{BRIDGE_CFG}/env\nExecStart={BRIDGE_BIN}\n"
        "Restart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=default.target\n"
    )


def install_bridge() -> None:
    venv = BRIDGE_DIR / "venv"
    run([sys.executable, "-m", "venv", "--without-pip", str(venv)])
    if not DRY_RUN and not (venv / "bin/pip").exists():
        getpip = CACHE_DIR / "get-pip.py"
        getpip.parent.mkdir(parents=True, exist_ok=True)
        run(["curl", "-fsSL", "https://bootstrap.pypa.io/get-pip.py", "-o", str(getpip)])
        run([str(venv / "bin/python"), str(getpip), "-q"])
    run([str(venv / "bin/pip"), "install", "-q", "--upgrade", f"git+{BRIDGE_REPO}"])
    if service_active("ha-ble-vhci", user=True):
        run(["systemctl", "--user", "restart", "ha-ble-vhci"])  # pick up the new version


def _hidden(prompt: str) -> str:
    log(f"{prompt}<hidden input, not logged>")
    return getpass.getpass(prompt).strip()


def configure_ha() -> None:
    url = ha_url_configured()
    if not url:
        say("  Looking for Home Assistant (ESPHome Bluetooth proxy) on LAN / Tailscale ...")
        found = ha_candidates()
        if found:
            say("  found: " + ", ".join(found))
        if found and confirm(f"Use Home Assistant at {found[0]}?"):
            url = found[0]
        elif not DRY_RUN:
            url = ask("  Home Assistant URL (e.g. http://100.x.y.z:8123), Enter to abort: ").strip().rstrip("/")
        if not url:
            raise StepError("No Home Assistant configured: plug in a USB Bluetooth (BLE) dongle instead.")
    elif (BRIDGE_CFG / "token").exists():
        say(f"  the stored token for {url} was rejected; enter a new one")
    say(f"  Create a long-lived token of an admin user: {url}/profile/security -> Long-lived access tokens")
    token = "dry-run-token" if DRY_RUN else _hidden("  Paste the token (hidden, Enter to abort): ")
    if not token:
        raise StepError("no token given")
    write_file(BRIDGE_CFG / "token", token + "\n", 0o600)
    write_file(BRIDGE_CFG / "env", f"HA_URL={url}\n", 0o600)


def adapter_appears() -> None:
    for attempt in range(2):
        for _ in range(15):
            if virtual_adapter():
                return
            time.sleep(1)
        if attempt == 0:
            run(["systemctl", "--user", "restart", "ha-ble-vhci"])
    tail = out(["journalctl", "--user", "-u", "ha-ble-vhci", "-n", "15", "--no-pager"])
    raise StepError("the virtual adapter did not appear. Service log:\n" + tail)


def bluetooth_actions() -> list[Action]:
    return [
        Action(f"ha-ble-vhci {BRIDGE_VERSION} installed", bridge_current, install_bridge),
        Action("Home Assistant URL + token stored", lambda: bool(ha_url_configured()) and (BRIDGE_CFG / "token").exists(), configure_ha),
        Action("Home Assistant reachable, token valid and admin", ha_valid, configure_ha,
               hint="Check the URL/token (the token must belong to an admin user)."),
        Action("udev rule + hci_vhci autoload",
               lambda: read_text(UDEV_RULE) == UDEV_RULE_TEXT and (read_text(MODULES_CONF) or "").strip() == "hci_vhci",
               lambda: (sudo_write(UDEV_RULE, UDEV_RULE_TEXT), sudo_write(MODULES_CONF, "hci_vhci\n"))),
        Action("/dev/vhci exists (hci_vhci loaded)", lambda: Path("/dev/vhci").exists(),
               lambda: run(["modprobe", "hci_vhci"], sudo=True)),
        Action("/dev/vhci usable by you", lambda: os.access("/dev/vhci", os.R_OK | os.W_OK),
               lambda: (run(["udevadm", "control", "--reload"], sudo=True), run(["udevadm", "trigger"], sudo=True)),
               hint="Log out and back in once (so the new device ACL / plugdev membership applies), then re-run."),
        Action("bluetooth.service running", lambda: service_active("bluetooth"),
               lambda: run(["systemctl", "enable", "--now", "bluetooth"], sudo=True)),
        Action("ha-ble-vhci user service running",
               lambda: BRIDGE_UNIT.exists() and service_active("ha-ble-vhci", user=True)
               and out(["systemctl", "--user", "is-enabled", "ha-ble-vhci"]) == "enabled",
               lambda: (write_file(BRIDGE_UNIT, bridge_unit_text()),
                        run(["systemctl", "--user", "daemon-reload"]),
                        run(["systemctl", "--user", "enable", "ha-ble-vhci"]),
                        run(["systemctl", "--user", "restart", "ha-ble-vhci"]))),
        Action("virtual Bluetooth adapter registered", lambda: virtual_adapter() is not None,
               adapter_appears),
        Action("adapter powered on", lambda: "Powered: yes" in out(["bluetoothctl", "show"]),
               lambda: run(["bluetoothctl", "power", "on"], check=False)),
    ]


# --------------------------------------------------------------------------- firefox
def deb_firefox_installed() -> bool:
    version = out(["dpkg-query", "-W", "-f=${Version}", "firefox"])
    return Path("/usr/lib/firefox/firefox").exists() and bool(version) and "snap" not in version


def snap_firefox_present() -> bool:
    return Path("/snap/firefox/current").exists()


def firefox_running() -> bool:
    return bool(out(["pgrep", "-x", "firefox"]) or out(["pgrep", "-f", "/snap/firefox/"]))


def mozilla_repo_ok() -> bool:
    return (MOZ_KEY.exists() and MOZ_LIST.exists() and MOZ_PIN.exists()
            and "packages.mozilla.org" in out(["apt-cache", "policy", "firefox"], timeout=60))


def snap_profile() -> Path | None:
    ini = SNAP_PROFILE / "profiles.ini"
    if not ini.exists():
        return None
    cp = configparser.ConfigParser()
    cp.read(ini)
    paths = [(s.get("Path"), s.get("Default") == "1") for n, s in cp.items() if n.startswith("Profile") and s.get("Path")]
    paths.sort(key=lambda t: not t[1])
    for rel, _ in paths:
        if (SNAP_PROFILE / rel).is_dir():
            return SNAP_PROFILE / rel
    return None


def profile_copied() -> bool:
    prof = snap_profile()
    return prof is None or (MOZ_PROFILE / prof.name / "prefs.js").exists()


def install_mozilla_repo() -> None:
    run(["install", "-d", "-m0755", "/etc/apt/keyrings"], sudo=True)
    run(["curl", "-fsSL", "https://packages.mozilla.org/apt/repo-signing-key.gpg", "-o", str(MOZ_KEY)], sudo=True)
    sudo_write(MOZ_LIST, f"deb [signed-by={MOZ_KEY}] https://packages.mozilla.org/apt mozilla main\n")
    sudo_write(MOZ_PIN, "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n")
    run(["apt-get", "update"], sudo=True)


def copy_profile() -> None:
    prof = snap_profile()
    assert prof
    while firefox_running() and not DRY_RUN:
        ask("  Close Firefox completely, then press Enter... ")
    run(["rsync", "-a", f"{prof}/", f"{MOZ_PROFILE / prof.name}/"])
    if not DRY_RUN:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        MIGRATED_NOTE.write_text(prof.name + "\n")
    if not (MOZ_PROFILE / "profiles.ini").exists():
        run(["cp", str(SNAP_PROFILE / "profiles.ini"), str(MOZ_PROFILE / "profiles.ini")])
    if not DRY_RUN:
        for lock in ("lock", ".parentlock"):
            (MOZ_PROFILE / prof.name / lock).unlink(missing_ok=True)


def read_ini(path: Path) -> configparser.RawConfigParser:
    cp = configparser.RawConfigParser()
    cp.optionxform = str  # keep key case (Name, Path, Default, Locked)
    cp.read(path)
    return cp


def write_ini(cp: configparser.RawConfigParser, path: Path) -> None:
    with open(path, "w") as handle:
        cp.write(handle, space_around_delimiters=False)


def install_default_name() -> str | None:
    """The profile this Firefox install starts with (installs.ini / profiles.ini)."""
    for ini in (MOZ_PROFILE / "installs.ini", MOZ_PROFILE / "profiles.ini"):
        cp = read_ini(ini)
        for section in cp.sections():
            if cp.has_option(section, "Default") and (ini.name == "installs.ini" or section.startswith("Install")):
                return cp.get(section, "Default")
    cp = read_ini(MOZ_PROFILE / "profiles.ini")
    for section in cp.sections():
        if section.startswith("Profile") and cp.get(section, "Default", fallback="") == "1":
            return cp.get(section, "Path", fallback=None)
    return None


def active_profile() -> Path | None:
    name = install_default_name()
    return MOZ_PROFILE / name if name else None


MIGRATED_NOTE = STATE_DIR / "migrated-profile"


def migrated_name() -> str | None:
    """Name of the profile copied from the snap (it may be gone from ~/snap after `snap remove`)."""
    candidates: list[str | None] = [snap_profile().name if snap_profile() else None]
    try:
        candidates.append(MIGRATED_NOTE.read_text().strip())
    except OSError:
        pass
    # profiles.ini copied from the snap marks its profile Default=1; the deb then made its own
    # install default. A Default=1 profile that is not the install default is the migrated one.
    cp = read_ini(MOZ_PROFILE / "profiles.ini")
    candidates += [cp.get(sec, "Path", fallback=None) for sec in cp.sections()
                   if sec.startswith("Profile") and cp.get(sec, "Default", fallback="") == "1"]
    for name in candidates:
        if name and (MOZ_PROFILE / name / "prefs.js").exists():
            return name
    return None


def migrated_is_default() -> bool:
    name = migrated_name()
    return name is None or install_default_name() == name


def set_install_default() -> None:
    """Make the migrated snap profile the one deb Firefox starts (it created a fresh, locked one)."""
    name = migrated_name()
    assert name
    while firefox_running() and not DRY_RUN:
        ask("  Close Firefox completely, then press Enter... ")
    say(f"  start profile: {install_default_name()} -> {name} (backups: *.bak-passkey-qr; "
        "the fresh profile is kept, nothing is deleted)")
    if DRY_RUN:
        return
    for fname in ("profiles.ini", "installs.ini"):
        path = MOZ_PROFILE / fname
        if path.exists():
            shutil.copy2(path, path.with_name(fname + ".bak-passkey-qr"))
    cp = read_ini(MOZ_PROFILE / "profiles.ini")
    if not any(cp.get(sec, "Path", fallback="") == name for sec in cp.sections()):
        index = 0
        while cp.has_section(f"Profile{index}"):
            index += 1
        cp.add_section(f"Profile{index}")
        for key, value in (("Name", "migrated"), ("IsRelative", "1"), ("Path", name)):
            cp.set(f"Profile{index}", key, value)
    for sec in cp.sections():
        if sec.startswith("Profile"):
            if cp.get(sec, "Path", fallback="") == name:
                cp.set(sec, "Default", "1")
            elif cp.has_option(sec, "Default"):
                cp.remove_option(sec, "Default")
        elif sec.startswith("Install") and cp.has_option(sec, "Default"):
            cp.set(sec, "Default", name)
    write_ini(cp, MOZ_PROFILE / "profiles.ini")
    inst = read_ini(MOZ_PROFILE / "installs.ini")
    for sec in inst.sections():
        inst.set(sec, "Default", name)
    if inst.sections():
        write_ini(inst, MOZ_PROFILE / "installs.ini")


def firefox_actions() -> list[Action]:
    return [
        Action("Mozilla apt repo + pin (so apt does not bring the snap back)", mozilla_repo_ok, install_mozilla_repo),
        Action("Firefox deb installed",
               deb_firefox_installed,
               # Ubuntu's transitional package has epoch 1:, so Mozilla's deb counts as a downgrade
               lambda: apt_install(["firefox"], extra=["--allow-downgrades"])),
        Action("snap profile copied to ~/.mozilla/firefox", profile_copied, copy_profile),
        Action("your migrated profile is the one Firefox starts (deb Firefox made a fresh one)",
               migrated_is_default, set_install_default),
        Action("Firefox snap removed (snapd keeps an automatic snapshot)", lambda: not snap_firefox_present(),
               lambda: run(["snap", "remove", "firefox"], sudo=True), optional=True),
    ]


# --------------------------------------------------------------------------- credentialsd + portal
@dataclass
class Project:
    name: str
    repo: str
    ref: str
    is_tag: bool
    recurse: bool
    setup: list[str]
    build_dir: str

    @property
    def path(self) -> Path:
        return SRC_DIR / self.name

    @property
    def build(self) -> Path:
        return self.path / self.build_dir


PROJECTS = [
    Project("credentialsd", CREDSD_REPO, CREDSD_TAG, True, False, ["-Dprefix=/usr/local"], "build-release"),
    # Ubuntu's libdex is built without gdbus support, which the portal fork requires
    Project("libdex", "https://gitlab.gnome.org/GNOME/libdex.git", "1.2.0", True, False,
            ["--prefix", "/usr/local", "-Dgdbus=enabled", "-Dexamples=false", "-Dtests=false", "-Dvapi=false",
             "-Dintrospection=disabled", "-Dpygobject=false", "-Ddocs=false"], "_build"),
    Project("xdg-desktop-portal", PORTAL_REPO, PORTAL_BRANCH, False, True,
            ["--prefix", "/usr/local", "-Dtests=disabled", "-Ddocumentation=disabled", "-Dman-pages=disabled"], "_build"),
]


def git_out(path: Path, *args: str) -> str:
    return out(["git", "-C", str(path), *args])


def source_ready(p: Project) -> bool:
    if not (p.path / ".git").exists():
        return False
    at_ref = (git_out(p.path, "describe", "--tags", "--exact-match") == p.ref if p.is_tag
              else git_out(p.path, "rev-parse", "--abbrev-ref", "HEAD") == p.ref)
    subs = git_out(p.path, "submodule", "status", "--recursive").splitlines() if p.recurse else []
    return at_ref and not any(line[:1] in "-+U" for line in subs)


def fetch_source(p: Project) -> None:
    if (p.path / ".git").exists():
        run(["git", "-C", str(p.path), "fetch", "--tags", "origin"])
    else:
        p.path.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", *(["--recurse-submodules"] if p.recurse else []), p.repo, str(p.path)])
    run(["git", "-C", str(p.path), "checkout", p.ref])
    if p.recurse:
        run(["git", "-C", str(p.path), "submodule", "update", "--init", "--recursive"])


def installed_map(p: Project) -> dict[str, str]:
    if not (p.build / "meson-private").exists():
        return {}
    try:
        return json.loads(out(["meson", "introspect", "--installed", str(p.build)], timeout=60))
    except json.JSONDecodeError:
        return {}


def is_installed(p: Project) -> bool:
    files = installed_map(p)
    return bool(files) and all(os.path.lexists(dest) for dest in files.values())


def is_built(p: Project) -> bool:
    if is_installed(p):
        return True
    files = installed_map(p)
    return bool(files) and all(os.path.lexists(src) for src in files if src.startswith(str(p.build)))


def install_project(p: Project) -> None:
    """Install what was built. --no-rebuild: otherwise root re-runs the always-stale cargo/ninja
    targets with root's toolchain and leaves root-owned files in the user's build directory."""
    run(["meson", "install", "-C", p.build_dir, "--no-rebuild"], cwd=p.path, sudo=True)
    owner = f"{os.getuid()}:{os.getgid()}"
    run(["chown", "-R", owner, str(p.build)], sudo=True)  # undo any root-owned leftovers


def libdex_gdbus_ready() -> bool:
    return bool(out(["pkg-config", "--variable=gdbus_codegen_extension", "libdex-1"]))


def build_project(p: Project) -> None:
    ensure_local_bin_on_path()
    if p.name == "xdg-desktop-portal" and not DRY_RUN and not libdex_gdbus_ready():
        raise StepError("the portal needs libdex built with gdbus support installed system-wide "
                        "(pkg-config variable gdbus_codegen_extension is empty): install the libdex step first.")
    if p.name == "credentialsd" and rust_channel():
        os.environ["RUSTUP_TOOLCHAIN"] = rust_channel()  # overrides rust-toolchain.toml (no extra components)
    run_resolving(["meson", "setup", *p.setup, p.build_dir, "--reconfigure"], p.path)
    run_resolving(["meson", "compile", "-C", p.build_dir], p.path)


def credentialsd_activatable() -> bool:
    return "xyz.iinuwa.credentialsd" in out(["busctl", "--user", "list", "--activatable", "--no-pager"])


def portal_credential_ready() -> bool:
    intro = out(["busctl", "--user", "introspect", "org.freedesktop.portal.Desktop",
                 "/org/freedesktop/portal/desktop", "--no-pager"], timeout=30)
    return "org.freedesktop.portal.experimental.Credential" in intro


def reload_user_services() -> None:
    run(["systemctl", "--user", "daemon-reload"])
    run(["systemctl", "--user", "reload", "dbus"], check=False)  # dbus-daemon re-reads service files


def restart_portal() -> None:
    reload_user_services()
    run(["systemctl", "--user", "restart", "xdg-desktop-portal"])
    if not DRY_RUN:
        for _ in range(15):
            if portal_credential_ready():
                return
            time.sleep(1)


def libdex_linked() -> bool:
    return "/usr/local" in out(["sh", "-c", "ldconfig -p | grep 'libdex-1'"])


def rust_channel() -> str | None:
    text = read_text(SRC_DIR / "credentialsd" / "rust-toolchain.toml") or ""
    match = re.search(r'^channel\s*=\s*"([^"]+)"', text, re.M)
    return match.group(1) if match else None


def rust_ok() -> bool:
    channel = rust_channel()
    if not channel:
        return False
    ensure_local_bin_on_path()
    return channel in out([str(CARGO_BIN / "rustup"), "run", channel, "cargo", "--version"], timeout=60)


def install_rust() -> None:
    """credentialsd pins a Rust newer than Ubuntu's (its manifest needs TOML 1.1): use rustup in ~/.cargo."""
    channel = rust_channel()
    assert channel
    rustup = CARGO_BIN / "rustup"
    if not rustup.exists():
        script = CACHE_DIR / "rustup-init.sh"
        if not DRY_RUN:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
        run(["curl", "--proto", "=https", "--tlsv1.2", "-sSf", "https://sh.rustup.rs", "-o", str(script)])
        run(["sh", str(script), "-y", "--profile", "minimal", "--default-toolchain", "none", "--no-modify-path"])
    run([str(rustup), "toolchain", "install", channel, "--profile", "minimal"])
    ensure_local_bin_on_path()


def credentialsd_actions() -> list[Action]:
    blueprint = Action(f"blueprint-compiler >= {'.'.join(map(str, BLUEPRINT_MIN))} (built into ~/.local; Ubuntu ships 0.19)",
                       blueprint_ok, build_blueprint)
    rust = Action("Rust toolchain pinned by credentialsd (via rustup in ~/.cargo; Ubuntu's cargo is too old)",
                  rust_ok, install_rust)
    actions: list[Action] = []
    for p in PROJECTS:
        actions.append(Action(f"{p.name}: source at {p.ref}" + (" with submodules" if p.recurse else ""),
                              lambda p=p: source_ready(p), lambda p=p: fetch_source(p)))
        if p.name == "credentialsd":
            actions += [rust, blueprint]
        actions += [
            Action(f"{p.name}: built (missing build dependencies are installed automatically)",
                   lambda p=p: is_built(p), lambda p=p: build_project(p)),
            Action(f"{p.name}: installed into /usr/local", lambda p=p: is_installed(p),
                   lambda p=p: install_project(p)),
        ]
        if p.name == "libdex":
            actions.append(Action("libdex from /usr/local is known to the dynamic linker",
                                  libdex_linked, lambda: run(["ldconfig"], sudo=True)))
    actions.append(Action("xdg-desktop-portal: credential portal enabled (systemd user drop-in)",
                          lambda: read_text(PORTAL_DROPIN) == PORTAL_DROPIN_TEXT,
                          lambda: (write_file(PORTAL_DROPIN, PORTAL_DROPIN_TEXT),
                                   run(["systemctl", "--user", "daemon-reload"]))))
    actions += [
        Action("session bus knows the credentialsd service files", credentialsd_activatable, reload_user_services,
               hint="Log out and back in once so the session picks up the new activation files, then re-run."),
        Action("patched portal answers with the Credential interface", portal_credential_ready, restart_portal,
               hint="Log out and back in once, then re-run; see the log for the portal journal."),
    ]
    return actions


# --------------------------------------------------------------------------- extension
def nm_link() -> Path:
    return HOME / ".mozilla/native-messaging-hosts" / NM_MANIFEST


def nm_target() -> Path:
    lib64 = Path("/usr/local/lib64")
    libdir = lib64 if lib64.is_dir() and not lib64.is_symlink() else Path("/usr/local/lib")
    return libdir / "mozilla/native-messaging-hosts" / NM_MANIFEST


def nm_ok() -> bool:
    link = nm_link()
    return link.is_symlink() and link.exists()


def link_nm() -> None:
    if not DRY_RUN:
        nm_link().parent.mkdir(parents=True, exist_ok=True)
    run(["ln", "-sfn", str(nm_target()), str(nm_link())])


def extension_in_profile() -> bool:
    profile = active_profile()
    for ext_json in ([profile / "extensions.json"] if profile else []):
        try:
            for addon in json.loads(ext_json.read_text()).get("addons", []):
                if addon.get("id") == XPI_ID and addon.get("active"):
                    return True
        except (OSError, json.JSONDecodeError):
            continue
    return False


FIREFOX_BIN = "/usr/lib/firefox/firefox"


def extension_granted() -> bool:
    """The policy install grants <all_urls> automatically; confirm it in the profile."""
    profile = active_profile()
    for prefs in ([profile / "extension-preferences.json"] if profile else []):
        try:
            entry = json.loads(prefs.read_text()).get(XPI_ID, {})
        except (OSError, json.JSONDecodeError):
            continue
        if "<all_urls>" in entry.get("origins", []):
            return True
    return False


def extension_ready() -> bool:
    return extension_in_profile() and extension_granted()


def restart_firefox() -> None:
    if out(["pgrep", "-x", "firefox"]):
        say("  closing Firefox (session restore brings your tabs back)")
        run(["pkill", "-TERM", "-x", "firefox"], check=False)
        for _ in range(40):
            if not out(["pgrep", "-x", "firefox"]):
                break
            time.sleep(1)
        else:
            raise StepError("Firefox did not close within 40 s: close it manually and re-run.")
    fflog = STATE_DIR / "firefox.log"
    say(f"  starting Firefox (its output goes to {fflog})")
    if DRY_RUN:
        run([FIREFOX_BIN])
        return
    with open(fflog, "a") as handle:
        subprocess.Popen([FIREFOX_BIN], start_new_session=True, stdout=handle, stderr=handle,
                         stdin=subprocess.DEVNULL)
    for _ in range(60):
        time.sleep(2)
        if extension_ready():
            return
    # run_actions turns a still-failing check into a StepError with the hint


def policy_data() -> dict:
    try:
        return json.loads(FIREFOX_POLICIES.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def policy_ok() -> bool:
    entry = policy_data().get("policies", {}).get("ExtensionSettings", {}).get(XPI_ID, {})
    return entry.get("installation_mode") == "normal_installed" and entry.get("install_url") == XPI_URL


def install_policy() -> None:
    data = policy_data()
    data.setdefault("policies", {}).setdefault("ExtensionSettings", {})[XPI_ID] = {
        "installation_mode": "normal_installed",  # installed for you, but you can still disable/remove it
        "install_url": XPI_URL,
    }
    sudo_write(FIREFOX_POLICIES, json.dumps(data, indent=2) + "\n")


def extension_actions() -> list[Action]:
    return [
        Action("native-messaging host linked for Firefox (replaces a manual manifest)", nm_ok, link_nm,
               hint=f"{nm_target()} is missing: the credentialsd install step has to succeed first."),
        Action("Firefox policy installs the signed extension on next start", policy_ok, install_policy),
        Action("Firefox restarted: extension active with access to all sites", extension_ready, restart_firefox,
               hint="Firefox did not report the extension as installed within 2 minutes: see "
                    f"{STATE_DIR}/firefox.log and about:policies / about:addons."),
    ]


# --------------------------------------------------------------------------- steps
def step_packages() -> bool:
    def install_missing() -> None:
        apt_install(missing_apt())

    return run_actions("1. Build and runtime packages",
                       [Action("all required apt packages installed", lambda: not missing_apt(), install_missing)])


def step_firefox() -> bool:
    return run_actions("2. Firefox (non-snap)", firefox_actions(),
                       "  The snap sandbox blocks the native-messaging host the extension needs.")


def step_bluetooth() -> bool:
    if real_adapters():
        say("\n== 3. Bluetooth for the QR (hybrid) flow ==")
        say("  local adapter(s) present: " + ", ".join(real_adapters()) + " - nothing to do")
        return True
    return run_actions(
        "3. Bluetooth for the QR (hybrid) flow", bluetooth_actions(),
        "  No physical Bluetooth adapter. The QR flow needs the PC to hear the phone's BLE advert;\n"
        "  ha-ble-vhci provides that from a Home Assistant Bluetooth proxy.")


def step_credentialsd() -> bool:
    return run_actions("4. credentialsd + patched xdg-desktop-portal", credentialsd_actions(),
                       "  Built from source into /usr/local; this takes a while.")


def step_extension() -> bool:
    return run_actions("5. Firefox extension + native-messaging host", extension_actions())


STEPS = [step_packages, step_firefox, step_bluetooth, step_credentialsd, step_extension]


def cmd_status(_: argparse.Namespace) -> None:
    groups = [
        ("1. Packages", [Action("all required apt packages installed", lambda: not missing_apt(), lambda: None)]),
        ("2. Firefox", firefox_actions()),
        ("4. credentialsd + portal", credentialsd_actions()),
        ("5. Extension", extension_actions()),
    ]
    if real_adapters():
        say("== 3. Bluetooth ==\n  local adapter(s): " + ", ".join(real_adapters()))
    else:
        groups.insert(2, ("3. Bluetooth via Home Assistant", bluetooth_actions()))
    for title, actions in groups:
        say(f"\n== {title} ==")
        show_actions(actions)
    missing = missing_apt()
    if missing:
        say("\n  missing packages: " + " ".join(missing))


def log_snapshot() -> None:
    """Write the facts needed to debug a run into the log file (no secrets)."""
    cmds = [
        ["uname", "-a"], [FIREFOX_BIN, "--version"], ["bluetoothctl", "list"],
        ["systemctl", "--user", "is-active", "ha-ble-vhci", "xdg-desktop-portal", "dbus"],
        ["busctl", "--user", "list", "--activatable", "--no-pager"],
        ["busctl", "--user", "introspect", "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop", "--no-pager"],
        ["cat", str(FIREFOX_POLICIES)], ["ls", "-l", str(HOME / ".mozilla/native-messaging-hosts")],
        ["journalctl", "--user", "-u", "ha-ble-vhci", "-n", "25", "--no-pager"],
        ["journalctl", "--user", "-u", "xdg-desktop-portal", "-n", "25", "--no-pager"],
        ["journalctl", "--user", "-n", "40", "--no-pager", "-t", "credentialsd"],
        ["journalctl", "--user", "-n", "25", "--no-pager", "-u", "xyz.iinuwa.credentialsd*"],
    ]
    log("\n===== snapshot =====")
    for cmd in cmds:
        log(f"$ {' '.join(cmd)}")
        log(out(cmd, timeout=40) or "(empty)")
    log(f"active profile: {active_profile()} (installs.ini default: {install_default_name()})")
    for prefs in MOZ_PROFILE.glob("*/extension-preferences.json"):
        try:
            log(f"{prefs}: {json.loads(prefs.read_text()).get(XPI_ID)}")
        except (OSError, json.JSONDecodeError):
            pass
    log(f"extension_in_profile={extension_in_profile()} granted={extension_granted()}")
    log("===== end snapshot =====")


def open_test_page() -> None:
    url = "https://webauthn.io"
    if not confirm(f"Open {url} in Firefox now to test the phone/QR option?"):
        return
    if DRY_RUN:
        run([FIREFOX_BIN, "--new-tab", url])
        return
    subprocess.Popen([FIREFOX_BIN, "--new-tab", url], start_new_session=True, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)


def cmd_install(_: argparse.Namespace) -> None:
    say("passkey-qr changes your system step by step; every step asks first, and anything already\n"
        "applied (checked against the real system state) is skipped.")
    for step in STEPS:
        step()
    say("\nFinal state:")
    cmd_status(argparse.Namespace())
    log_snapshot()
    if not (extension_ready() and portal_credential_ready()):
        say("\nNot everything is in place yet: see the unchecked items above and the log.")
        return
    say("\nEverything is installed and verified. On webauthn.io choose register/sign in, then the "
        "phone/QR option and scan the code (the phone must be within BLE range of the ESP32 proxy).")
    open_test_page()


def main() -> None:
    global DRY_RUN
    parser = argparse.ArgumentParser(prog="passkey-qr", description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true", help="print the commands, change nothing, auto-answer yes")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="show which actions are really applied").set_defaults(func=cmd_status)
    sub.add_parser("install", help="apply everything that is missing").set_defaults(func=cmd_install)
    args = parser.parse_args()
    DRY_RUN = args.dry_run
    log_path = init_log(args.cmd)
    say(f"log file: {log_path}")
    try:
        args.func(args)
    except StepError as err:
        log_snapshot()
        sys.exit(f"\nstopped: {err}\nFix the cause and re-run `passkey-qr install`: finished actions are skipped.\n"
                 f"Full log: {log_path}")
    except subprocess.CalledProcessError as err:
        log_snapshot()
        sys.exit(f"\ncommand failed (exit {err.returncode}): {' '.join(map(str, err.cmd))}\n"
                 f"Re-run `passkey-qr install` after fixing it: finished actions are skipped.\nFull log: {log_path}")
    except (KeyboardInterrupt, EOFError):
        log("aborted by user")
        sys.exit("\naborted")
    except Exception:
        import traceback
        log(traceback.format_exc())
        raise
    say(f"\nlog file: {log_path}")


if __name__ == "__main__":
    main()
