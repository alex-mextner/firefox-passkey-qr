# ----- the health check itself (`passkey-qr health`, run by passkey-qr-health.timer)
def journal_is_stdout() -> bool:
    """systemd's documented check: $JOURNAL_STREAM names the journal stream (dev:ino) our stdout is connected to."""
    try:
        stat = os.fstat(sys.stdout.fileno())
    except (OSError, ValueError):
        return False
    return os.environ.get("JOURNAL_STREAM") == f"{stat.st_dev}:{stat.st_ino}"


def hlog(message: str, level: int = 6) -> None:
    """A journal line; when stdout is the journal the <N> prefix sets its priority (4 = warning)."""
    say(f"<{level}>{message}" if journal_is_stdout() else message)


def notify(title: str, body: str, *, urgent: bool = False) -> None:
    hlog(f"notify: {title} - {body}", 4 if urgent else 6)
    if DRY_RUN:
        return
    exe = shutil.which("notify-send")
    if not exe:
        hlog("notify-send is not installed: the user cannot be told on the desktop", 4)
        return
    try:
        result = subprocess.run([exe, "-a", "passkey-qr", "-u", "critical" if urgent else "normal",
                                 "-i", "dialog-warning" if urgent else "dialog-information", title, body],
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as err:
        hlog(f"notify-send failed: {err}", 4)
        return
    if result.returncode != 0:  # e.g. no notification daemon yet at an early login
        hlog(f"notify-send failed (exit {result.returncode}): {(result.stderr or '').strip()}", 4)


def load_health_state() -> dict:
    try:
        data = json.loads(HEALTH_STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save_health_state(state: dict) -> None:
    if DRY_RUN:
        return
    try:
        HEALTH_STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = HEALTH_STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state))
        tmp.replace(HEALTH_STATE)
    except OSError as err:
        hlog(f"cannot save {HEALTH_STATE}: {err}", 4)


def may_act(state: dict, key: str, now: float, cooldown: float) -> bool:
    """True (and remembered) at most once per ``cooldown`` for the repair named ``key``."""
    acted = state.setdefault("acted", {})
    if 0 <= now - acted.get(key, 0) < cooldown:  # a clock set back counts as expired, not as "wait for it"
        return False
    acted[key] = now
    return True


def report(state: dict, key: str, ok: bool, now: float, *, up: tuple[str, str],
           down: tuple[str, str] | None = None) -> None:
    """One desktop notification per outage of ``key``: after HEALTH_CONFIRM_RUNS failing runs, a reminder
    every HEALTH_REMIND_SECONDS, a 'recovered' one when it ends; an outage right after a recovery is a flap
    and stays in the journal only."""
    entry = state.setdefault("issues", {}).setdefault(key, {})
    if ok:
        if entry.get("notified"):
            notify(*up)
            entry["recovered_at"] = now
        elif entry.get("fails"):
            hlog(f"{key}: ok again")
        entry["fails"], entry["notified"] = 0, 0
        return
    assert down, "a failing report needs its notification text"
    entry["fails"] = entry.get("fails", 0) + 1
    hlog(f"{key}: FAILING ({entry['fails']}x): {down[0]}", 4)
    if entry["fails"] < HEALTH_CONFIRM_RUNS:
        return
    first = not entry.get("notified")
    flapping = now - entry.get("recovered_at", 0) < HEALTH_COOLDOWN_SECONDS
    if (first and not flapping) or (not first and now - entry["notified"] >= HEALTH_REMIND_SECONDS):
        notify(*down, urgent=True)
        entry["notified"] = now


def session_ready() -> bool:
    """A graphical session: the systemd target is active, or (Xfce, i3, ... started without it) the user manager
    knows a display."""
    if out(["systemctl", "--user", "is-active", "graphical-session.target"]) == "active":
        return True
    return bool(re.search(r"^(WAYLAND_DISPLAY|DISPLAY)=", out(["systemctl", "--user", "show-environment"]), re.M))


def unit_age(unit: str) -> float:
    """Seconds since the unit became active (CLOCK_MONOTONIC, the clock systemd stamps with)."""
    stamp = out(["systemctl", "--user", "show", "-p", "ActiveEnterTimestampMonotonic", "--value", f"{unit}.service"])
    return time.monotonic() - int(stamp) / 1e6 if stamp.isdigit() and int(stamp) else 0.0


def scanner_log_says_none(now: float) -> bool:
    """Did the bridge say 'no Bluetooth scanner is connected' (journal, current run of the service only) longer
    than SCANNER_STALE_SECONDS ago, without a scanner coming online since? Per-scanner 'offline' lines are not
    enough: with two proxies one may be unplugged for good while the other works."""
    age = unit_age("ha-ble-vhci")
    if not age:
        return False
    text = out(["journalctl", "--user", "-u", "ha-ble-vhci", "-o", "short-unix", "--no-pager",
                "--since", f"@{now - age:.0f}", "-n", "1", "-g", "no Bluetooth scanner|Bluetooth scanner online"])
    match = re.match(r"(\d+(?:\.\d+)?) \S+ \S+: (.*)", text.splitlines()[-1]) if text else None
    return bool(match) and "no Bluetooth scanner" in match.group(2) and now - float(match.group(1)) > SCANNER_STALE_SECONDS


def restart_unit(unit: str) -> None:
    run(["systemctl", "--user", "reset-failed", unit], check=False)
    run(["systemctl", "--user", "restart", unit], check=False)


def health_bluetooth(state: dict, now: float) -> None:
    # a bridge the user disabled on purpose (`systemctl --user disable --now`) is left alone
    needs_bridge = unit_loaded("ha-ble-vhci") and user_unit_enabled("ha-ble-vhci") and not real_adapters()
    settled = True  # a bridge that has just (re)started needs a while to register its adapter
    if needs_bridge:
        if not service_active("ha-ble-vhci", user=True):
            settled = False
            if may_act(state, "bridge-start", now, BRIDGE_RESTART_COOLDOWN):  # on top of systemd's own Restart=
                hlog("ha-ble-vhci is not running: starting it", 4)
                restart_unit("ha-ble-vhci")
        else:
            settled = unit_age("ha-ble-vhci") > BRIDGE_SETTLE_SECONDS
            if not bt_adapters() and settled and may_act(state, "bridge-restart", now, BRIDGE_RESTART_COOLDOWN):
                hlog("ha-ble-vhci is running but registered no Bluetooth adapter: restarting it", 4)
                restart_unit("ha-ble-vhci")
                settled = False
                for _ in range(15):
                    if bt_adapters():
                        break
                    time.sleep(1)
    up = ("Bluetooth adapter is back", "Passkey QR can find phones again.")
    if bt_adapters():
        shown = out(["bluetoothctl", "show"])
        if "Powered: yes" not in shown:
            hlog("the Bluetooth adapter is not powered: powering it on", 4)
            out(["bluetoothctl", "power", "on"], timeout=15)  # bounded: it waits forever for a dead bluetoothd
            shown = out(["bluetoothctl", "show"])
        report(state, "bluetooth-adapter", "Powered: yes" in shown, now, up=up,
               down=("Bluetooth adapter is powered off",
                     "Passkey QR needs the Bluetooth adapter on; `bluetoothctl power on` did not work."))
    elif needs_bridge and settled:
        report(state, "bluetooth-adapter", False, now, up=up,
               down=("No Bluetooth adapter",
                     "The ha-ble-vhci bridge registered no adapter, so the passkey QR dialog hangs. "
                     "See: journalctl --user -u ha-ble-vhci"))
    if needs_bridge:
        health_proxy(state, now)
    else:  # a real adapter (or no bridge): an old outage must not carry over to the next time the bridge is needed
        for key in ("bluetooth-proxy", "bluetooth-adapter") if not bt_adapters() else ("bluetooth-proxy",):
            state.get("issues", {}).pop(key, None)


def health_proxy(state: dict, now: float) -> None:
    up = ("Bluetooth proxy is back online", "Passkey QR works again: Home Assistant sees the ESP32.")
    fake = os.environ.get("PASSKEY_QR_HEALTH_FAKE_SCANNERS_EXIT", "").strip()  # test/demo seam: pretend the exit code
    if fake.isdigit():
        code: int | None = int(fake)
    else:
        result = scanners_result()
        code = None if result is None else result.returncode
        if code == 1 and "Traceback" in (result.stderr or ""):
            code = 70  # the bridge itself crashed: that says nothing about Home Assistant
    if code is None or code not in (0, 1, 4):
        # Home Assistant is not configured, the bridge did not answer in time or is too old for --scanners
        # (argparse exit 2): nothing trustworthy to compare against, and not Home Assistant's fault
        if code is not None:
            hlog(f"ha-ble-vhci --scanners exited {code}: cannot tell whether a proxy is online", 4)
        return
    if code == 0:
        report(state, "bluetooth-proxy", True, now, up=up)
        if scanner_log_says_none(now) and may_act(state, "bridge-stale-scanner", now, BRIDGE_RESTART_COOLDOWN):
            hlog("Home Assistant sees a scanner but the bridge says 'none' for a while: restarting ha-ble-vhci", 4)
            restart_unit("ha-ble-vhci")
        return
    if code == 4:
        down = ("Bluetooth proxy (ESP32) is offline",
                "Home Assistant has no Bluetooth proxy online, so the passkey QR dialog will hang. "
                "Power on or reconnect the ESP32; this repairs itself once it is back.")
    else:
        down = ("Home Assistant is unreachable",
                f"Cannot reach Home Assistant ({ha_url_configured() or 'URL not set'}; scanner query exit {code}), "
                "so the passkey QR dialog will hang. Check that it is running and the network is up.")
    report(state, "bluetooth-proxy", False, now, down=down, up=up)


def health_portal(state: dict, now: float) -> None:
    ready = portal_credential_ready()
    tries = state.setdefault("portal_restarts", 0)
    if ready:
        state["portal_restarts"] = 0
    elif tries < MAX_PORTAL_RESTARTS and may_act(state, "restart-portal", now, RESTART_COOLDOWN):
        # other apps use the portal too: after a few restarts that did not help, only report
        state["portal_restarts"] = tries + 1
        hlog("the portal does not offer org.freedesktop.portal.experimental.Credential: restarting xdg-desktop-portal", 4)
        restart_unit("xdg-desktop-portal")
        deadline = time.monotonic() + 20  # a hung portal makes every probe slow: bound the wait by time, not tries
        while time.monotonic() < deadline:
            ready = portal_credential_ready()
            if ready:
                break
            time.sleep(1)
    report(state, "portal", ready, now,
           down=("The credential portal is not working",
                 "Passkey sign-in cannot start: xdg-desktop-portal has no Credential interface and a restart "
                 "did not fix it. See: journalctl --user -u xdg-desktop-portal"),
           up=("The credential portal works again", "Passkey sign-in can start again."))


def start_activatable(name: str) -> bool:
    return out(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus", "StartServiceByName", "su", name, "0"], timeout=30).startswith("u ")


def health_credentialsd(state: dict, now: float) -> None:
    for unit in loaded_units(CREDENTIALSD_UNITS):
        started = start_activatable(unit)
        if not started and may_act(state, f"restart-{unit}", now, RESTART_COOLDOWN):
            hlog(f"{unit} did not start on demand: restarting it", 4)
            restart_unit(unit)
            started = start_activatable(unit)
        report(state, unit, started, now,
               down=(f"{unit} does not start", f"Passkey sign-in cannot work. See: journalctl --user -u {unit}"),
               up=(f"{unit} works again", "Passkey sign-in can start again."))


def stuck_helpers(limit: float) -> list[tuple[int, int]]:
    """``(pid, age in seconds)`` of this user's Firefox native-messaging helpers older than ``limit``."""
    found = []
    for line in out(["ps", "-u", str(os.getuid()), "-o", "pid=,etimes=,args="]).splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3 or not (parts[0].isdigit() and parts[1].isdigit()) or int(parts[0]) == os.getpid():
            continue
        argv = parts[2].split()  # the helper is a script: `python3 .../credentialsd-firefox-helper`, or run directly
        if Path(argv[0]).name == "env" and len(argv) > 1:
            argv = argv[1:]
        script = argv[1] if Path(argv[0]).name.startswith("python") and len(argv) > 1 else argv[0]
        if Path(script).name == HELPER_NAME and int(parts[1]) >= limit:
            found.append((int(parts[0]), int(parts[1])))
    return found


def still_helper(pid: int) -> bool:
    """The pid is still the helper `ps` showed (it may have exited and the pid been reused since)."""
    try:
        return HELPER_NAME in Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace")
    except OSError:
        return False


def stuck_limit() -> float:
    try:
        return float(os.environ.get("PASSKEY_QR_STUCK_SECONDS") or STUCK_SECONDS)  # the seam used by demos
    except ValueError:
        return STUCK_SECONDS


def health_stuck_requests(state: dict, now: float) -> None:
    """The helper is spawned once per WebAuthn request (its own timeout defaults to 5 min) and ignores SIGTERM
    when its request hangs; an abandoned request keeps credentialsd scanning forever, so end it and restart
    credentialsd + its UI - but only once no other request is in flight (the restart would abort it)."""
    helpers = stuck_helpers(0)
    limit = stuck_limit()
    stuck = [(pid, age) for pid, age in helpers if age >= limit]
    for pid, age in stuck:
        hlog(f"stuck passkey request: {HELPER_NAME} pid {pid} is {age}s old: sending it SIGKILL", 4)
        if not DRY_RUN and still_helper(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    if stuck:
        state["restart_credentialsd"] = True
    if not state.get("restart_credentialsd"):
        return
    if any(pid not in {p for p, _ in stuck} for pid, _ in helpers):
        hlog("another passkey request is in progress: restarting credentialsd after it ends")
        return
    for unit in loaded_units(CREDENTIALSD_UNITS):
        run(["systemctl", "--user", "restart", unit], check=False)
    state["restart_credentialsd"] = False


def health(now: float | None = None) -> int:
    now = time.time() if now is None else now
    state = load_health_state()
    graphical = session_ready()  # the portal and credentialsd only live inside the graphical session
    if not graphical:
        hlog("no graphical session (no graphical-session.target, no display in the user manager): the portal and "
             "credentialsd checks are skipped")
    # the stuck-request cleanup comes first: it is the cheapest check and the one a hung portal must not starve
    checks = [health_stuck_requests, health_bluetooth, *([health_portal, health_credentialsd] if graphical else [])]
    failed = False
    for check in checks:
        try:
            check(state, now)
        except Exception:  # one broken check must not stop the others
            hlog(f"{check.__name__} crashed:\n{traceback.format_exc()}", 3)
            failed = True
        save_health_state(state)  # after every check: a run cut off by TimeoutStartSec keeps what it learned
    return 1 if failed else 0


def cmd_health(_: argparse.Namespace) -> None:
    """Run by passkey-qr-health.timer. Exit 1 only when a check itself crashed."""
    sys.exit(health())


def cmd_heal_prefs(_: argparse.Namespace) -> None:
    """Run by passkey-qr-prefs.path and at login: re-apply only the managed user.js block when it drifted."""
    if not managed_profiles():
        hlog("no Firefox profile to manage yet")
        return
    if usb_token_off_ok():
        hlog("Firefox prefs are in place")
        return
    hlog("Firefox prefs drifted (a Firefox update or a new profile dropped the user.js block): re-applying", 4)
    disable_usb_token()
    notify("Firefox passkey settings were re-applied",
           "A Firefox update or profile change had removed them. Restart Firefox once for them to take effect.")


# --------------------------------------------------------------------------- steps
def packages_actions() -> list[Action]:
    return [Action("all required apt packages installed", lambda: not missing_apt(), lambda: apt_install(missing_apt()))]


def step_packages() -> bool:
    return run_actions("1. Build and runtime packages", packages_actions())


def step_firefox() -> bool:
    return run_actions("2. Firefox (non-snap)", firefox_actions(),
                       "  The snap sandbox blocks the native-messaging host the extension needs.")


def step_bluetooth() -> bool:
    if real_adapters():
        say("\n== 3. Bluetooth for the QR (hybrid) flow ==")
        say("  local adapter(s) present: " + ", ".join(real_adapters()) + " - nothing to do")
        return True
    return run_actions(
        "3. Bluetooth for the QR (hybrid) flow", bluetooth_actions(),
        "  No physical Bluetooth adapter. The QR flow needs the PC to hear the phone's BLE advert;\n"
        "  ha-ble-vhci provides that from a Home Assistant Bluetooth proxy.")


def step_credentialsd() -> bool:
    return run_actions("4. credentialsd + patched xdg-desktop-portal", credentialsd_actions(),
                       "  Built from source into /usr/local; this takes a while.")


def step_extension() -> bool:
    return run_actions("5. Firefox extension + native-messaging host", extension_actions())


def step_selfheal() -> bool:
    return run_actions("6. Self-healing (restart policy, health check, Firefox prefs)", selfheal_actions(),
                       "  Every link of the chain restarts on its own; a timer repairs hung ones and tells you\n"
                       "  on the desktop when the Bluetooth proxy (ESP32) is offline.")


STEPS = [step_packages, step_firefox, step_bluetooth, step_credentialsd, step_extension, step_selfheal]


def status_groups() -> list[tuple[str, list[Action]]]:
    """The step groups with their actions; step 3 has none when a physical adapter is present."""
    return [
        ("1. Packages", packages_actions()),
        ("2. Firefox", firefox_actions()),
        ("3. Bluetooth via Home Assistant", [] if real_adapters() else bluetooth_actions()),
        ("4. credentialsd + portal", credentialsd_actions()),
        ("5. Extension", extension_actions()),
        ("6. Self-healing", selfheal_actions()),
    ]


def cmd_status(_: argparse.Namespace) -> None:
    for title, actions in status_groups():
        if title.startswith("3.") and real_adapters():
            say("\n== 3. Bluetooth ==\n  local adapter(s): " + ", ".join(real_adapters()))
            continue
        say(f"\n== {title} ==")
        show_actions(actions)
        if title.startswith("3."):
            show_proxy_status()
    missing = missing_apt()
    if missing:
        say("\n  missing packages: " + " ".join(missing))


def status_rows() -> list[tuple[str, bool, bool]]:
    """``(label, ok, required)``: ``required`` rows decide ``check``; the others are context.
    Bluetooth is one required row (any adapter, local or ha-ble-vhci); how it is provided is context."""
    rows = [("Bluetooth adapter (local or ha-ble-vhci)", bool(bt_adapters()), True)]
    for title, actions in status_groups():
        if title.startswith("3."):
            rows += [(a.name, a.check(), False) for a in actions]
        else:
            rows += [(a.name, a.check(), a.required and not a.optional) for a in actions]
    return rows


def unmet_rows(rows: list[tuple[str, bool, bool]]) -> list[str]:
    return [label for label, ok, required in rows if required and not ok]


def cmd_check(_: argparse.Namespace) -> None:
    """Read-only: exit 0 when every required row holds, 3 (and the unmet rows) otherwise."""
    unmet = unmet_rows(status_rows())
    for label in unmet:
        say(f"  missing: {label}")
    sys.exit(3 if unmet else 0)


SNAPSHOT_TIMEOUT = 8  # seconds per diagnostic command: the snapshot must never delay the real error message


def log_snapshot() -> None:
    """Write the facts needed to debug a run into the log file (no secrets); never raises."""
    if not LOG_FILE:
        return
    try:
        _write_snapshot()
    except Exception as err:  # a failing diagnostic must not mask the StepError that called it
        log(f"(snapshot failed: {err})")


def _write_snapshot() -> None:
    cmds = [
        ["uname", "-a"], [FIREFOX_BIN, "--version"], ["bluetoothctl", "list"],
        ["systemctl", "--user", "is-active", "ha-ble-vhci", "xdg-desktop-portal", "dbus"],
        ["busctl", "--user", "list", "--activatable", "--no-pager"],
        ["busctl", "--user", "introspect", "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop", "--no-pager"],
        ["cat", str(FIREFOX_POLICIES)], ["ls", "-l", str(HOME / ".mozilla/native-messaging-hosts")],
        ["journalctl", "--user", "-u", "ha-ble-vhci", "-n", "25", "--no-pager"],
        ["journalctl", "--user", "-u", "xdg-desktop-portal", "-n", "25", "--no-pager"],
        ["journalctl", "--user", "-n", "40", "--no-pager", "-t", "credentialsd"],
        ["journalctl", "--user", "-n", "25", "--no-pager", "-u", "xyz.iinuwa.credentialsd*"],
    ]
    log("\n===== snapshot =====")
    for cmd in cmds:
        log(f"$ {' '.join(cmd)}")
        log(out(cmd, timeout=SNAPSHOT_TIMEOUT) or "(empty)")
    log(f"active profile: {active_profile()} (installs.ini default: {install_default_name()})")
    for prefs in MOZ_PROFILE.glob("*/extension-preferences.json"):
        try:
            log(f"{prefs}: {json.loads(prefs.read_text()).get(XPI_ID)}")
        except (OSError, json.JSONDecodeError):
            pass
    log(f"extension_in_profile={extension_in_profile()} granted={extension_granted()}")
    log("===== end snapshot =====")


def open_test_page() -> None:
    if ASSUME_YES:  # unattended runs (ubuntu-tweak init) must not pop a browser tab open
        return
    url = "https://webauthn.io"
    if not confirm(f"Open {url} in Firefox now to test the phone/QR option?"):
        return
    if DRY_RUN:
        run([FIREFOX_BIN, "--new-tab", url])
        return
    subprocess.Popen([FIREFOX_BIN, "--new-tab", url], start_new_session=True, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)


def cmd_install(_: argparse.Namespace) -> None:
    """Exit codes: 0 everything required is in place; 3 finished what it could and something waits for
    you (listed); 1 a step failed (StepError / failed command, see main)."""
    say("passkey-qr changes your system step by step; "
        + ("--yes answers every step for you" if ASSUME_YES else "every step asks first")
        + ", and anything already\napplied (checked against the real system state) is skipped.")
    for step in STEPS:
        step()
    if DRY_RUN:
        if NOTES:
            say("\nWould need you: " + "; ".join(NOTES))
        return
    rows = status_rows()  # every check runs once; the printout, exit code and hints all come from it
    say("\nFinal state:")
    for label, ok, _ in rows:
        say(f"  [{'x' if ok else ' '}] {label}")
    log_snapshot()
    unmet = unmet_rows(rows)
    if NOTES or unmet:
        say("\nNot finished:")
        for note in NOTES:
            say(f"  waiting for you: {note}")
        for label in unmet:
            say(f"  missing: {label}")
        say("Do that, then re-run `passkey-qr install`: finished actions are skipped.")
        sys.exit(3)
    if all(ok for label, ok, _ in rows if label.startswith("Firefox restarted")):
        say("\nEverything is installed and verified. On webauthn.io choose register/sign in, then the "
            "phone/QR option and scan the code (the phone must be within BLE range of the ESP32 proxy).")
    else:
        say("\nEverything is installed. Restart Firefox once: it then installs the extension and offers "
            "the phone/QR option (test on https://webauthn.io; the phone must be within BLE range "
            "of the ESP32 proxy).")
    open_test_page()


def main() -> None:
    global DRY_RUN, ASSUME_YES, REMOVE_SNAP
    parser = argparse.ArgumentParser(prog="passkey-qr", description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true", help="print the commands, change nothing, auto-answer yes")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="answer yes to every step and never prompt (a token must be in $HA_TOKEN or the "
                             "token file; the Firefox snap is kept unless --remove-snap)")
    parser.add_argument("--remove-snap", action="store_true",
                        help="with --yes, also remove the Firefox snap after the deb is installed")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="show which actions are really applied").set_defaults(func=cmd_status)
    sub.add_parser("check", help="exit 0 when everything required is in place, 3 otherwise (read-only)"
                   ).set_defaults(func=cmd_check)
    sub.add_parser("install", help="apply everything that is missing").set_defaults(func=cmd_install)
    sub.add_parser("health", help="one self-healing pass (run every 45 s by passkey-qr-health.timer)"
                   ).set_defaults(func=cmd_health)
    sub.add_parser("heal-prefs", help="re-apply the Firefox user.js block if it drifted (run by passkey-qr-prefs.path)"
                   ).set_defaults(func=cmd_heal_prefs)
    args = parser.parse_args()
    DRY_RUN, ASSUME_YES, REMOVE_SNAP = args.dry_run, args.yes, args.remove_snap
    log_path = init_log(args.cmd) if args.cmd == "install" and not DRY_RUN else None
    if log_path:
        say(f"log file: {log_path}")
    where = f"Full log: {log_path}" if log_path else "(no log file: not an install run)"

    def waiting() -> str:
        """What already waits for a person, so a later failure does not hide it."""
        return "".join(f"\nstill waiting for you: {note}" for note in NOTES)

    try:
        args.func(args)
    except StepError as err:
        log(f"STOPPED: {err}")
        print(f"\nstopped: {err}\nFix the cause and re-run `passkey-qr install`: finished actions are skipped.\n"
              f"{where}{waiting()}", file=sys.stderr, flush=True)
        log_snapshot()  # after the message: a broken session must not delay it
        sys.exit(1)
    except subprocess.CalledProcessError as err:
        log(f"COMMAND FAILED (exit {err.returncode}): {err.cmd}")
        print(f"\ncommand failed (exit {err.returncode}): {' '.join(map(str, err.cmd))}\n"
              f"Re-run `passkey-qr install` after fixing it: finished actions are skipped.\n{where}{waiting()}",
              file=sys.stderr, flush=True)
        log_snapshot()
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        log("aborted by user")
        sys.exit("\naborted")
    except Exception:
        log(traceback.format_exc())
        raise
    if log_path:
        say(f"\nlog file: {log_path}")


if __name__ == "__main__":
    main()
