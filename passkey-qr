def deb_firefox_installed() -> bool:
    version = out(["dpkg-query", "-W", "-f=${Version}", "firefox"])
    return Path("/usr/lib/firefox/firefox").exists() and bool(version) and "snap" not in version


def snap_firefox_present() -> bool:
    return Path("/snap/firefox/current").exists()


def firefox_running() -> bool:
    return bool(out(["pgrep", "-x", "firefox"]) or out(["pgrep", "-f", "/snap/firefox/"]))


def mozilla_repo_ok() -> bool:
    return (MOZ_KEY.exists() and MOZ_LIST.exists() and MOZ_PIN.exists()
            and "packages.mozilla.org" in out(["apt-cache", "policy", "firefox"], timeout=60))


def snap_profile() -> Path | None:
    ini = SNAP_PROFILE / "profiles.ini"
    if not ini.exists():
        return None
    cp = configparser.ConfigParser()
    cp.read(ini)
    paths = [(s.get("Path"), s.get("Default") == "1") for n, s in cp.items() if n.startswith("Profile") and s.get("Path")]
    paths.sort(key=lambda t: not t[1])
    for rel, _ in paths:
        if (SNAP_PROFILE / rel).is_dir():
            return SNAP_PROFILE / rel
    return None


def profile_copied() -> bool:
    prof = snap_profile()
    return prof is None or (MOZ_PROFILE / prof.name / "prefs.js").exists()


def install_mozilla_repo() -> None:
    run(["install", "-d", "-m0755", "/etc/apt/keyrings"], sudo=True)
    run(["curl", "-fsSL", "https://packages.mozilla.org/apt/repo-signing-key.gpg", "-o", str(MOZ_KEY)], sudo=True)
    sudo_write(MOZ_LIST, f"deb [signed-by={MOZ_KEY}] https://packages.mozilla.org/apt mozilla main\n")
    sudo_write(MOZ_PIN, "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n")
    run(["apt-get", "update"], sudo=True)


def need_firefox_closed() -> None:
    if firefox_running() and ASSUME_YES:  # also in --dry-run: the preview must show what the real run waits for
        raise NeedsYou("Firefox is running and --yes cannot ask you to close it: close it and re-run")
    if DRY_RUN:
        return
    while firefox_running():
        ask("  Close Firefox completely, then press Enter... ")


def copy_profile() -> None:
    prof = snap_profile()
    assert prof
    need_firefox_closed()
    run(["rsync", "-a", f"{prof}/", f"{MOZ_PROFILE / prof.name}/"])
    if not DRY_RUN:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        MIGRATED_NOTE.write_text(prof.name + "\n")
    if not (MOZ_PROFILE / "profiles.ini").exists():
        run(["cp", str(SNAP_PROFILE / "profiles.ini"), str(MOZ_PROFILE / "profiles.ini")])
    if not DRY_RUN:
        for lock in ("lock", ".parentlock"):
            (MOZ_PROFILE / prof.name / lock).unlink(missing_ok=True)


def read_ini(path: Path) -> configparser.RawConfigParser:
    """Tolerant read for checks: a missing or unparsable file is just empty."""
    cp = configparser.RawConfigParser()
    cp.optionxform = str  # keep key case (Name, Path, Default, Locked)
    try:
        cp.read(path)
    except configparser.Error:
        return configparser.RawConfigParser()
    return cp


def read_ini_for_edit(path: Path) -> configparser.RawConfigParser:
    """Strict read before rewriting a user's file: never overwrite what cannot be parsed."""
    cp = configparser.RawConfigParser()
    cp.optionxform = str
    try:
        cp.read(path)
    except configparser.Error as err:
        raise StepError(f"{path} cannot be parsed ({err}); fix it by hand, nothing was changed") from err
    return cp


def write_ini(cp: configparser.RawConfigParser, path: Path) -> None:
    with open(path, "w", encoding="utf-8") as handle:
        cp.write(handle, space_around_delimiters=False)


# Firefox names an install by a hash of its directory. Mozilla's deb lives in /usr/lib/firefox, so the hash is the
# same on every machine (it is also what the deb wrote on the first one). Seeding this section is how the
# deb adopts the migrated profile at its very first start, with no Firefox launched by the installer.
DEB_INSTALL_HASH = "4F96D1932A9F858E"


def install_default_name() -> str | None:
    """The profile the deb Firefox starts: its own section of installs.ini, else of profiles.ini. Other
    installs' sections (the snap's stale one, ESR, ...) say nothing about it."""
    inst = read_ini(MOZ_PROFILE / "installs.ini")
    if inst.has_option(DEB_INSTALL_HASH, "Default"):
        return inst.get(DEB_INSTALL_HASH, "Default")
    cp = read_ini(MOZ_PROFILE / "profiles.ini")
    return cp.get(f"Install{DEB_INSTALL_HASH}", "Default", fallback=None)


def active_profile() -> Path | None:
    name = install_default_name()
    return MOZ_PROFILE / name if name else None


MIGRATED_NOTE = STATE_DIR / "migrated-profile"
SWITCHED_NOTE = STATE_DIR / "profile-switched"  # written once the start profile was switched


def migrated_name() -> str | None:
    """Name of the profile copied from the snap, or None when there was no migration. Only evidence of
    one counts (the note written by the copy, or the snap's own profile): a legacy `Default=1` profile of
    a stock Firefox is not a migrated one."""
    snap = snap_profile()
    if snap:  # the source exists, so the copy is (or is about to be) made by the action before this one
        return snap.name
    try:
        note = MIGRATED_NOTE.read_text().strip()
    except OSError:
        return None
    return note if note and (MOZ_PROFILE / note / "prefs.js").exists() else None


def migrated_is_default() -> bool:
    """True when there is nothing to switch, or the switch was done: after it, a different default is the
    user's own choice in about:profiles and is neither drift nor reverted."""
    name = migrated_name()
    return name is None or install_default_name() == name or SWITCHED_NOTE.exists()


def _seed_install(cp: configparser.RawConfigParser, section: str, name: str) -> None:
    if not cp.has_section(section):
        cp.add_section(section)
    cp.set(section, "Default", name)
    cp.set(section, "Locked", "1")


def set_install_default() -> None:
    """Make the migrated snap profile the one the deb Firefox starts: by its own install section, written
    before its first start or switched after it created a fresh, locked profile. Other installs' sections
    are left alone."""
    name = migrated_name()
    assert name
    need_firefox_closed()
    if not DRY_RUN and not (MOZ_PROFILE / name / "prefs.js").exists():
        # e.g. the copy was declined in an interactive run: never point Firefox at a directory that is not there
        raise StepError(f"the profile {name} was not copied to {MOZ_PROFILE}: copy it first (answer yes to "
                        "'snap profile copied') and re-run")
    say(f"  start profile: {install_default_name() or '(not started yet)'} -> {name} "
        "(backups: *.bak-passkey-qr; a fresh profile is kept, nothing is deleted)")
    if DRY_RUN:
        return
    cp = read_ini_for_edit(MOZ_PROFILE / "profiles.ini")
    inst = read_ini_for_edit(MOZ_PROFILE / "installs.ini")
    for fname in ("profiles.ini", "installs.ini"):
        path = MOZ_PROFILE / fname
        backup = path.with_name(fname + ".bak-passkey-qr")
        if path.exists() and not backup.exists():  # the first backup is the user's original, keep it
            shutil.copy2(path, backup)
    if not cp.has_section("General"):
        cp.add_section("General")
        cp.set("General", "StartWithLastProfile", "1")
        cp.set("General", "Version", "2")
    if not any(cp.get(sec, "Path", fallback="") == name for sec in cp.sections()):
        index = 0
        while cp.has_section(f"Profile{index}"):
            index += 1
        cp.add_section(f"Profile{index}")
        for key, value in (("Name", "migrated"), ("IsRelative", "1"), ("Path", name)):
            cp.set(f"Profile{index}", key, value)
    for sec in cp.sections():
        if sec.startswith("Profile"):
            if cp.get(sec, "Path", fallback="") == name:
                cp.set(sec, "Default", "1")
            elif cp.has_option(sec, "Default"):
                cp.remove_option(sec, "Default")
    _seed_install(cp, f"Install{DEB_INSTALL_HASH}", name)
    _seed_install(inst, DEB_INSTALL_HASH, name)
    MOZ_PROFILE.mkdir(parents=True, exist_ok=True)
    write_ini(cp, MOZ_PROFILE / "profiles.ini")
    write_ini(inst, MOZ_PROFILE / "installs.ini")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    SWITCHED_NOTE.write_text(name + "\n")


def firefox_actions() -> list[Action]:
    return [
        Action("Mozilla apt repo + pin (so apt does not bring the snap back)", mozilla_repo_ok, install_mozilla_repo),
        Action("Firefox deb installed",
               deb_firefox_installed,
               # Ubuntu's transitional package has epoch 1:, so Mozilla's deb counts as a downgrade
               lambda: apt_install(["firefox"], extra=["--allow-downgrades"])),
        Action("snap profile copied to ~/.mozilla/firefox", profile_copied, copy_profile),
        Action("your migrated profile is the one Firefox starts (deb Firefox made a fresh one)",
               migrated_is_default, set_install_default),
        Action("Firefox snap removed (snapd keeps an automatic snapshot)", lambda: not snap_firefox_present(),
               lambda: run(["snap", "remove", "firefox"], sudo=True), optional=True, destructive=True),
    ]


# --------------------------------------------------------------------------- credentialsd + portal
@dataclass
class Project:
    name: str
    repo: str
    ref: str
    is_tag: bool
    recurse: bool
    setup: list[str]
    build_dir: str

    @property
    def path(self) -> Path:
        return SRC_DIR / self.name

    @property
    def build(self) -> Path:
        return self.path / self.build_dir


PROJECTS = [
    Project("credentialsd", CREDSD_REPO, CREDSD_TAG, True, False, ["-Dprefix=/usr/local"], "build-release"),
    # Ubuntu's libdex is built without gdbus support, which the portal fork requires
    Project("libdex", "https://gitlab.gnome.org/GNOME/libdex.git", "1.2.0", True, False,
            ["--prefix", "/usr/local", "-Dgdbus=enabled", "-Dexamples=false", "-Dtests=false", "-Dvapi=false",
             "-Dintrospection=disabled", "-Dpygobject=false", "-Ddocs=false"], "_build"),
    Project("xdg-desktop-portal", PORTAL_REPO, PORTAL_BRANCH, False, True,
            ["--prefix", "/usr/local", "-Dtests=disabled", "-Ddocumentation=disabled", "-Dman-pages=disabled"], "_build"),
]


def git_out(path: Path, *args: str) -> str:
    return out(["git", "-C", str(path), *args])


def source_ready(p: Project) -> bool:
    if not (p.path / ".git").exists():
        return False
    at_ref = (git_out(p.path, "describe", "--tags", "--exact-match") == p.ref if p.is_tag
              else git_out(p.path, "rev-parse", "--abbrev-ref", "HEAD") == p.ref)
    subs = git_out(p.path, "submodule", "status", "--recursive").splitlines() if p.recurse else []
    return at_ref and not any(line[:1] in "-+U" for line in subs)


def fetch_source(p: Project) -> None:
    if (p.path / ".git").exists():
        run(["git", "-C", str(p.path), "fetch", "--tags", "origin"])
    else:
        p.path.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", *(["--recurse-submodules"] if p.recurse else []), p.repo, str(p.path)])
    run(["git", "-C", str(p.path), "checkout", p.ref])
    if p.recurse:
        run(["git", "-C", str(p.path), "submodule", "update", "--init", "--recursive"])


def installed_map(p: Project) -> dict[str, str]:
    if not (p.build / "meson-private").exists():
        return {}
    try:
        return json.loads(out(["meson", "introspect", "--installed", str(p.build)], timeout=60))
    except json.JSONDecodeError:
        return {}


def is_installed(p: Project) -> bool:
    files = installed_map(p)
    return bool(files) and all(os.path.lexists(dest) for dest in files.values())


def is_built(p: Project) -> bool:
    if is_installed(p):
        return True
    files = installed_map(p)
    return bool(files) and all(os.path.lexists(src) for src in files if src.startswith(str(p.build)))


def install_project(p: Project) -> None:
    """Install what was built. --no-rebuild: otherwise root re-runs the always-stale cargo/ninja
    targets with root's toolchain and leaves root-owned files in the user's build directory."""
    run(["meson", "install", "-C", p.build_dir, "--no-rebuild"], cwd=p.path, sudo=True)
    owner = f"{os.getuid()}:{os.getgid()}"
    run(["chown", "-R", owner, str(p.build)], sudo=True)  # undo any root-owned leftovers


def libdex_gdbus_ready() -> bool:
    return bool(out(["pkg-config", "--variable=gdbus_codegen_extension", "libdex-1"]))


def build_project(p: Project) -> None:
    ensure_local_bin_on_path()
    if p.name == "xdg-desktop-portal" and not DRY_RUN and not libdex_gdbus_ready():
        raise StepError("the portal needs libdex built with gdbus support installed system-wide "
                        "(pkg-config variable gdbus_codegen_extension is empty): install the libdex step first.")
    if p.name == "credentialsd" and rust_channel():
        os.environ["RUSTUP_TOOLCHAIN"] = rust_channel()  # overrides rust-toolchain.toml (no extra components)
    run_resolving(["meson", "setup", *p.setup, p.build_dir, "--reconfigure"], p.path)
    run_resolving(["meson", "compile", "-C", p.build_dir], p.path)


def system_portal_preferred() -> dict[str, str]:
    """The [preferred] backends of the portal config the desktop currently uses (to extend, not replace)."""
    desktops = [d.lower() for d in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if d]
    dirs = [Path("/etc/xdg/xdg-desktop-portal"), Path("/usr/local/share/xdg-desktop-portal")]
    dirs += [Path(d) / "xdg-desktop-portal" for d in os.environ.get("XDG_DATA_DIRS", "/usr/share").split(":") if d]
    names = [f"{d}-portals.conf" for d in desktops] + ["portals.conf"]
    for directory in dirs:
        for name in names:
            cp = read_ini(directory / name)
            if cp.has_section("preferred"):
                return dict(cp.items("preferred"))
    return {"default": "*"}


def portal_conf_files() -> list[Path]:
    """Files the portal reads first for this desktop: `<desktop>-portals.conf` beats `portals.conf`, so an
    existing desktop-specific user file has to carry the entry as well."""
    desktops = [d.lower() for d in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if d]
    specific = [PORTAL_CONF.with_name(f"{d}-portals.conf") for d in desktops]
    return [PORTAL_CONF, *[f for f in specific if f.exists()]]


def portal_conf_ok() -> bool:
    return all(read_ini(path).get("preferred", CREDENTIAL_IMPL_IFACE, fallback="") == "credentialsd"
               for path in portal_conf_files())


def write_portal_conf() -> None:
    """Without this the portal finds no backend for the Credential interface and never exports it:
    the desktop's own config (e.g. gnome-portals.conf) only lists gnome/gtk. Existing sections of the
    user's files are kept (their comments are not)."""
    for path in portal_conf_files():
        cp = read_ini_for_edit(path)
        if not cp.has_section("preferred"):
            cp.add_section("preferred")
            for key, value in system_portal_preferred().items():
                cp.set("preferred", key, value)
        cp.set("preferred", CREDENTIAL_IMPL_IFACE, "credentialsd")
        say(f"  write {path} (mode 644)")
        if not DRY_RUN:
            path.parent.mkdir(parents=True, exist_ok=True)
            write_ini(cp, path)


def credentialsd_activatable() -> bool:
    return "xyz.iinuwa.credentialsd" in out(["busctl", "--user", "list", "--activatable", "--no-pager"])


def portal_running() -> bool:
    """Introspecting an activatable name would start it: look at the owned names first, so `check` never does."""
    return "org.freedesktop.portal.Desktop" in out(["busctl", "--user", "list", "--acquired", "--no-pager"])


def portal_credential_ready() -> bool:
    if not portal_running():
        return False
    intro = out(["busctl", "--user", "introspect", "org.freedesktop.portal.Desktop",
                 "/org/freedesktop/portal/desktop", "--no-pager"], timeout=30)
    return "org.freedesktop.portal.experimental.Credential" in intro


def reload_user_services() -> None:
    run(["systemctl", "--user", "daemon-reload"])
    run(["systemctl", "--user", "reload", "dbus"], check=False)  # dbus-daemon re-reads service files


def restart_portal() -> None:
    reload_user_services()
    run(["systemctl", "--user", "restart", "xdg-desktop-portal"], check=False)  # no session: the re-check says so
    if not DRY_RUN:
        for _ in range(15):
            if portal_credential_ready():
                return
            time.sleep(1)


def libdex_linked() -> bool:
    return any("libdex-1" in line and "/usr/local" in line for line in out(["ldconfig", "-p"]).splitlines())


def rust_channel() -> str | None:
    text = read_text(SRC_DIR / "credentialsd" / "rust-toolchain.toml") or ""
    match = re.search(r'^channel\s*=\s*"([^"]+)"', text, re.M)
    return match.group(1) if match else None


def rust_ok() -> bool:
    channel = rust_channel()
    if not channel:
        return False
    ensure_local_bin_on_path()
    try:
        return subprocess.run([str(CARGO_BIN / "rustup"), "run", channel, "cargo", "--version"],
                              capture_output=True, timeout=60).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def install_rust() -> None:
    """credentialsd pins a Rust newer than Ubuntu's (its manifest needs TOML 1.1): use rustup in ~/.cargo."""
    # a dry run on a fresh machine has no credentialsd checkout yet: name where the pin will come from
    channel = rust_channel() or ("<channel pinned in credentialsd/rust-toolchain.toml>" if DRY_RUN else None)
    if not channel:
        raise StepError("credentialsd/rust-toolchain.toml not found: the credentialsd source step comes first")
    rustup = CARGO_BIN / "rustup"
    if not rustup.exists():
        script = CACHE_DIR / "rustup-init.sh"
        if not DRY_RUN:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
        run(["curl", "--proto", "=https", "--tlsv1.2", "-sSf", "https://sh.rustup.rs", "-o", str(script)])
        run(["sh", str(script), "-y", "--profile", "minimal", "--default-toolchain", "none", "--no-modify-path"])
    run([str(rustup), "toolchain", "install", channel, "--profile", "minimal"])
    ensure_local_bin_on_path()


def credentialsd_actions() -> list[Action]:
    blueprint = Action(f"blueprint-compiler >= {'.'.join(map(str, BLUEPRINT_MIN))} (built into ~/.local; Ubuntu ships 0.19)",
                       blueprint_ok, build_blueprint)
    rust = Action("Rust toolchain pinned by credentialsd (via rustup in ~/.cargo; Ubuntu's cargo is too old)",
                  rust_ok, install_rust)
    actions: list[Action] = []
    for p in PROJECTS:
        actions.append(Action(f"{p.name}: source at {p.ref}" + (" with submodules" if p.recurse else ""),
                              lambda p=p: source_ready(p), lambda p=p: fetch_source(p)))
        if p.name == "credentialsd":
            actions += [rust, blueprint]
        actions += [
            Action(f"{p.name}: built (missing build dependencies are installed automatically)",
                   lambda p=p: is_built(p), lambda p=p: build_project(p)),
            Action(f"{p.name}: installed into /usr/local", lambda p=p: is_installed(p),
                   lambda p=p: install_project(p)),
        ]
        if p.name == "libdex":
            actions.append(Action("libdex from /usr/local is known to the dynamic linker",
                                  libdex_linked, lambda: run(["ldconfig"], sudo=True)))
    actions.append(Action("xdg-desktop-portal: credential portal enabled (systemd user drop-in)",
                          lambda: read_text(PORTAL_DROPIN) == PORTAL_DROPIN_TEXT,
                          lambda: (write_file(PORTAL_DROPIN, PORTAL_DROPIN_TEXT),
                                   run(["systemctl", "--user", "daemon-reload"]))))
    actions += [
        Action("portal config names credentialsd as the Credential backend (~/.config/xdg-desktop-portal)",
               portal_conf_ok, write_portal_conf),
        Action("session bus knows the credentialsd service files", credentialsd_activatable, reload_user_services,
               needs_relogin=True,
               hint="Log out and back in once so the session picks up the new activation files, then re-run."),
        Action("patched portal answers with the Credential interface", portal_credential_ready, restart_portal,
               needs_relogin=True,
               hint="Log out and back in once, then re-run; see the log for the portal journal."),
    ]
    return actions


